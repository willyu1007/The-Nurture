# APP_ENV: Deployment environment profile.; type=enum; required; default='dev'
APP_ENV=dev

# DATABASE_URL: PostgreSQL connection URL for Nurture-owned production schema and migrations.; type=url; required; secret_ref=database_url
DATABASE_URL=<secret:database_url>

# DEV_HOST_DATABASE_URL: PostgreSQL connection URL for backend-private workflow dev-host schema and migrations.; type=url; required; secret_ref=dev_host_database_url
DEV_HOST_DATABASE_URL=<secret:dev_host_database_url>

# DEV_HOST_PORT: Loopback-only Fastify workflow dev-host listen port; never used by the formal scenario service.; type=int; optional; default=3001
DEV_HOST_PORT=3001

# FAMILY_GROWTH_EVENTS_SERVICE_TOKEN: Nurture-to-My-Chat bearer for family-growth event delivery (family_growth_transport@1.0.0); absent = delivery worker off.; type=string; optional; secret_ref=family_growth_events_service_token
FAMILY_GROWTH_EVENTS_SERVICE_TOKEN=<secret:family_growth_events_service_token>

# FAMILY_GROWTH_RENDITION_SERVICE_TOKEN: My-Chat-to-Nurture bearer validated by the rendition exchange (family_growth_transport@1.0.0); absent = endpoints refuse all requests.; type=string; optional; secret_ref=family_growth_rendition_service_token
FAMILY_GROWTH_RENDITION_SERVICE_TOKEN=<secret:family_growth_rendition_service_token>

# FAMILY_GROWTH_RENDITION_SERVICE_TOKEN_PREVIOUS: Rotation window twin of FAMILY_GROWTH_RENDITION_SERVICE_TOKEN; cleared after rotation completes.; type=string; optional; secret_ref=family_growth_rendition_service_token_previous
FAMILY_GROWTH_RENDITION_SERVICE_TOKEN_PREVIOUS=<secret:family_growth_rendition_service_token_previous>

# MY_CHAT_INTERNAL_BASE_URL: My-Chat host base URL for host-ward internal reads (ST-5 derived age/stage); the shared internal service token authenticates the call. Absence keeps derived reads disabled.; type=url; optional
MY_CHAT_INTERNAL_BASE_URL=

# NURTURE_BACKEND_URL: Local Base-assigned Nurture backend endpoint consumed by the frontend workbench; topology only, not an API-contract field.; type=url; optional; default='http://localhost:3200'
NURTURE_BACKEND_URL=http://localhost:3200

# NURTURE_BINDING_EVIDENCE_KEY: HMAC key (at least 32 characters) enabling the scenario-binding owner endpoint; absence keeps the endpoint disabled and never degrades to an unhashed path.; type=string; optional; secret_ref=nurture_binding_evidence_key
NURTURE_BINDING_EVIDENCE_KEY=<secret:nurture_binding_evidence_key>

# NURTURE_DIRECTOR_PRESENTER_ENABLED: Default-off gate for the read-only director presenter v1 composition; true requires the exact adopted contract digest, current-authority/owner ports and separate activation approval, and never enables Institution Mobile commands.; type=bool; optional; default=false
NURTURE_DIRECTOR_PRESENTER_ENABLED=false

# NURTURE_HARNESS_INTEGRITY_KEY: HMAC key (at least 32 characters) for Harness confirmation input-integrity tags and owner-issued target refs; absence keeps both Harness routes disabled.; type=string; optional; secret_ref=nurture_harness_integrity_key
NURTURE_HARNESS_INTEGRITY_KEY=<secret:nurture_harness_integrity_key>

# NURTURE_INSTITUTION_BUSINESS_COMMUNICATION_READ_ENABLED: Default-off provider gate for the protected Institution Admin business-communication owner-read; true only after exact interface pin and consumer adoption.; type=bool; optional; default=false
NURTURE_INSTITUTION_BUSINESS_COMMUNICATION_READ_ENABLED=false

# NURTURE_INTERNAL_SERVICE_TOKEN: Private My-Chat-to-Nurture service-auth token for owner endpoints; never persisted or logged.; type=string; optional; secret_ref=nurture_internal_service_token
NURTURE_INTERNAL_SERVICE_TOKEN=<secret:nurture_internal_service_token>

# NURTURE_PARENT_COMMUNICATION_OWNER_ENABLED: Default-off gate for the parent-communication owner v1 composition; true requires the exact adopted contract digest, complete authority/owner/async ports and separately authorized activation.; type=bool; optional; default=false
NURTURE_PARENT_COMMUNICATION_OWNER_ENABLED=false

# NURTURE_PARENT_CONTEXT_PRESENTER_ENABLED: Default-off gate for the parent-context presenter v1 owner composition; true requires the exact adopted contract digest and separately authorized owner-port activation.; type=bool; optional; default=false
NURTURE_PARENT_CONTEXT_PRESENTER_ENABLED=false

# NURTURE_PROTECTED_CONTENT_KEY: AES-256-GCM key material (at least 32 characters) sealing protected family-care bodies at rest; absence keeps both Harness routes disabled and never degrades to plaintext.; type=string; optional; secret_ref=nurture_protected_content_key
NURTURE_PROTECTED_CONTENT_KEY=<secret:nurture_protected_content_key>

# NURTURE_TEACHER_RELEASE_OWNER_ENABLED: Default-off gate for the versioned teacher release owner composition; true requires the exact My-Chat consumer pin and separately authorized activation.; type=bool; optional; default=false
NURTURE_TEACHER_RELEASE_OWNER_ENABLED=false

# PORT: Formal NestJS scenario-service listen port; local ecosystem routing maps the Base-assigned backend endpoint separately.; type=int; required; default=8000
PORT=8000

# SERVICE_NAME: Nurture owner service name used by logs and deployment metadata.; type=string; required; default='the-nurture'
SERVICE_NAME=the-nurture

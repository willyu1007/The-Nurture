model NurtureMediaAssetRef {
  id                         String                      @id @default(uuid())
  workspaceId                String                      @map("workspace_id")
  institutionId              String                      @map("institution_id")
  careGroupId                String?                     @map("care_group_id")
  uploadedByRoleAssignmentId String?                     @map("uploaded_by_role_assignment_id")
  sourceKind                 NurtureMediaAssetSourceKind @map("source_kind")
  storageRefPayload          Json                        @map("storage_ref_payload")
  safeTitle                  String?                     @map("safe_title")
  capturedAt                 DateTime?                   @map("captured_at")
  // Same vocabulary and same NULL semantics as `NurtureCareCapture`, derived
  // when the asset is reviewed.
  safetyMarkersPayload       Json?                       @map("safety_markers_payload")
  lifecycle                  NurtureMediaAssetLifecycle
  // The exact immutable original revision a draft or release binds to. It never
  // changes in place; a new original is a new revision.
  mediaRevision              Int                         @default(1) @map("media_revision")
  // SHA-256 of the exact original bytes at the current `mediaRevision`; a new
  // revision brings a new digest. Nullable only for pre-T-009 rows: the
  // family-growth envelope requires a real digest, so a release without one
  // fails closed at assembly rather than shipping a placeholder.
  contentDigest              String?                     @map("content_digest") @db.Char(64)
  // MIME type of the same bytes, required by the family-growth envelope with
  // the same pre-T-009 nullability and the same fail-closed rule.
  contentMimeType            String?                     @map("content_mime_type")
  aggregateVersion           Int                         @default(0) @map("aggregate_version")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  deletedAt                  DateTime?                   @map("deleted_at")

  institution  NurtureCareInstitution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  careGroup    NurtureCareGroup?              @relation(fields: [careGroupId], references: [id], onDelete: Restrict)
  uploadedBy   NurtureCareRoleAssignment?     @relation(fields: [uploadedByRoleAssignmentId], references: [id], onDelete: Restrict)
  attributions NurtureChildMediaAttribution[]
  captures     NurtureCareCapture[]

  @@index([workspaceId, institutionId, lifecycle, createdAt], map: "ix_nurture_media_asset_institution")
  @@index([workspaceId, careGroupId, lifecycle, createdAt], map: "ix_nurture_media_asset_group")
  @@map("nurture_media_asset_ref")
}


// ============================================================================
// T-006 STAGE G3 — CAPTURE, PUBLISH PROCESS AND PUBLICATION
// 06-g3-0-fact-contract-schema-freeze.md "DB SSOT Delta". Every model here is
// additive: no existing fact family gains a second source, and the board
// projection is never persisted as a unified child-state row.
// ============================================================================

// Explicit Goal <-> ChildCareProcess association. A child hint inside
// `goalPayload` is never inferred as child scope.
model NurtureFocusGoalChildScope {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id")
  focusGoalId        String    @map("focus_goal_id")
  childCareProcessId String    @map("child_care_process_id")
  scopeVersion       Int       @default(1) @map("scope_version")
  provenancePayload  Json?     @map("provenance_payload")
  aggregateVersion   Int       @default(0) @map("aggregate_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  focusGoal        NurtureFocusGoal        @relation(fields: [focusGoalId], references: [id], onDelete: Restrict)
  childCareProcess NurtureChildCareProcess @relation(fields: [childCareProcessId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, focusGoalId, childCareProcessId], map: "uq_nurture_focus_goal_child_scope")
  @@index([workspaceId, childCareProcessId], map: "ix_nurture_focus_goal_scope_process")
  @@map("nurture_focus_goal_child_scope")
}

// CareGroup-internal source material. Existence never implies family
// visibility, and protected content lives behind the same envelope as T-005.
model NurtureCareCapture {
  id                         String                 @id @default(uuid())
  workspaceId                String                 @map("workspace_id")
  careGroupId                String                 @map("care_group_id")
  captureBatchId             String?                @map("capture_batch_id")
  capturedByRoleAssignmentId String                 @map("captured_by_role_assignment_id")
  kind                       NurtureCareCaptureKind
  // Monotonic intake order inside the batch; the watermark is expressed in it.
  sourceSequence             Int                    @map("source_sequence")
  // False while an upload or save is still in flight. Only a stable prefix is cut.
  stable                     Boolean                @default(false)
  bodyProtectionPayload      Json?                  @map("body_protection_payload")
  transcriptRevision         String?                @map("transcript_revision")
  // Stable deterministic safety rule keys derived at intake, while the
  // ingesting path still holds the plaintext. Rule keys only: never body,
  // never model prose. NULL means "never derived" and is not the same fact as
  // an empty list, so the safety port can fail closed on an unread source.
  safetyMarkersPayload       Json?                  @map("safety_markers_payload")
  mediaAssetRefId            String?                @map("media_asset_ref_id")
  occurredAt                 DateTime               @map("occurred_at")
  aggregateVersion           Int                    @default(0) @map("aggregate_version")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  deletedAt                  DateTime?              @map("deleted_at")

  careGroup     NurtureCareGroup          @relation(fields: [careGroupId], references: [id], onDelete: Restrict)
  captureBatch  NurtureCareCaptureBatch?  @relation(fields: [captureBatchId], references: [id], onDelete: Restrict)
  capturedBy    NurtureCareRoleAssignment @relation(fields: [capturedByRoleAssignmentId], references: [id], onDelete: Restrict)
  mediaAssetRef NurtureMediaAssetRef?     @relation(fields: [mediaAssetRefId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, captureBatchId, sourceSequence], map: "uq_nurture_care_capture_sequence")
  @@index([workspaceId, careGroupId, occurredAt], map: "ix_nurture_care_capture_group")
  @@map("nurture_care_capture")
}

// One organize batch. It records the resolved trigger, the policy head it was
// decided under and the stable source watermark it cut at — never the raw
// device operation stream.
model NurtureCareCaptureBatch {
  id                      String                             @id @default(uuid())
  workspaceId             String                             @map("workspace_id")
  careGroupId             String                             @map("care_group_id")
  state                   NurtureCareCaptureBatchState
  resolvedTrigger         NurtureCareCaptureOrganizeTrigger? @map("resolved_trigger")
  triggerRequestId        String?                            @map("trigger_request_id")
  policyRef               String?                            @map("policy_ref")
  policyHead              Int?                               @map("policy_head")
  timeZone                String?                            @map("time_zone")
  quiescenceSeconds       Int?                               @map("quiescence_seconds")
  observedUserActivityAt  DateTime?                          @map("observed_user_activity_at")
  watermarkSourceSequence Int?                               @map("watermark_source_sequence")
  cutAt                   DateTime?                          @map("cut_at")
  aggregateVersion        Int                                @default(0) @map("aggregate_version")
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

  careGroup        NurtureCareGroup        @relation(fields: [careGroupId], references: [id], onDelete: Restrict)
  captures         NurtureCareCapture[]
  publishProcesses NurturePublishProcess[]

  // The same trigger identity is an exact replay, never a second batch.
  @@unique([workspaceId, careGroupId, triggerRequestId], map: "uq_nurture_care_capture_batch_trigger")
  @@index([workspaceId, careGroupId, state, createdAt], map: "ix_nurture_care_capture_batch_group")
  @@map("nurture_care_capture_batch")
}

// The caregiver-side content work unit. It owns no upload, CareInteraction,
// ActionDelivery or Institution Workflow state.
model NurturePublishProcess {
  id                          String                     @id @default(uuid())
  workspaceId                 String                     @map("workspace_id")
  careGroupId                 String                     @map("care_group_id")
  captureBatchId              String?                    @map("capture_batch_id")
  processKey                  String                     @map("process_key")
  state                       NurturePublishProcessState
  dataClass                   NurtureGrantDataClass      @map("data_class")
  purposeKey                  String                     @map("purpose_key")
  currentRevisionId           String?                    @unique @map("current_revision_id")
  // Set by the first committed target release; the shared revision is frozen then.
  frozenRevisionId            String?                    @map("frozen_revision_id")
  // Resolved once from the T-007 window and never silently moved afterwards.
  scheduledAt                 DateTime?                  @map("scheduled_at")
  notAfter                    DateTime?                  @map("not_after")
  scheduleTimeZone            String?                    @map("schedule_time_zone")
  schedulePolicyRef           String?                    @map("schedule_policy_ref")
  schedulePolicyHead          Int?                       @map("schedule_policy_head")
  // Frozen at resolution. These were being substituted by `aggregateVersion`
  // and `updatedAt`, which a reschedule moves — so a reschedule appeared to
  // change the policy version and the moment the window was resolved.
  schedulePolicyVersion       Int?                       @map("schedule_policy_version")
  scheduleResolvedAt          DateTime?                  @map("schedule_resolved_at")
  authorizingRoleAssignmentId String?                    @map("authorizing_role_assignment_id")
  // The instant the pre-release cancel committed. `updatedAt` cannot stand in:
  // anything else touching the row moves it, so an idempotent repeat of the
  // cancel would report a moment the cancel did not happen at.
  cancelledAt                 DateTime?                  @map("cancelled_at")
  aggregateVersion            Int                        @default(0) @map("aggregate_version")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  careGroup         NurtureCareGroup                 @relation(fields: [careGroupId], references: [id], onDelete: Restrict)
  captureBatch      NurtureCareCaptureBatch?         @relation(fields: [captureBatchId], references: [id], onDelete: Restrict)
  currentRevision   NurturePublishProcessRevision?   @relation("PublishProcessCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions         NurturePublishProcessRevision[]  @relation("PublishProcessRevisions")
  targets           NurturePublishProcessTarget[]
  editHold          NurturePublishEditHold?
  safetyAssessments NurtureContentSafetyAssessment[]
  releases          NurturePublicationRelease[]

  @@unique([workspaceId, processKey], map: "uq_nurture_publish_process_key")
  @@index([workspaceId, careGroupId, state, createdAt], map: "ix_nurture_publish_process_group")
  @@map("nurture_publish_process")
}

// Append-only shared composition. There is no target-specific hidden body:
// different content for a different family means a different process.
model NurturePublishProcessRevision {
  id                      String   @id @default(uuid())
  workspaceId             String   @map("workspace_id")
  publishProcessId        String   @map("publish_process_id")
  revision                Int
  contentDigest           String   @map("content_digest")
  organizerInputRevision  String   @map("organizer_input_revision")
  // The command that produced this revision. `organizerInputRevision` carries
  // the assembler's input revision and was being searched by command id, so the
  // replay lookup could never match; this is the identity it needs.
  commandRequestIdHash    String?  @map("command_request_id_hash") @db.Char(64)
  templateKey             String?  @map("template_key")
  templateVersion         String?  @map("template_version")
  titleProtectionPayload  Json?    @map("title_protection_payload")
  bodyProtectionPayload   Json?    @map("body_protection_payload")
  mediaCompositionPayload Json?    @map("media_composition_payload")
  sourceRefsPayload       Json?    @map("source_refs_payload")
  savedByRoleAssignmentId String?  @map("saved_by_role_assignment_id")
  createdAt               DateTime @default(now()) @map("created_at")

  publishProcess NurturePublishProcess       @relation("PublishProcessRevisions", fields: [publishProcessId], references: [id], onDelete: Restrict)
  currentOf      NurturePublishProcess?      @relation("PublishProcessCurrentRevision")
  releases       NurturePublicationRelease[]

  @@unique([workspaceId, publishProcessId, revision], map: "uq_nurture_publish_revision")
  @@unique([workspaceId, publishProcessId, commandRequestIdHash], map: "uq_nurture_publish_revision_command")
  @@map("nurture_publish_process_revision")
}

// The internal resolved target behind an opaque public ref. It carries identity
// only — never content.
model NurturePublishProcessTarget {
  id                 String   @id @default(uuid())
  workspaceId        String   @map("workspace_id")
  publishProcessId   String   @map("publish_process_id")
  targetKey          String   @map("target_key")
  childCareProcessId String   @map("child_care_process_id")
  enrollmentId       String   @map("enrollment_id")
  familyRefKey       String   @map("family_ref_key")
  grantId            String   @map("grant_id")
  aggregateVersion   Int      @default(0) @map("aggregate_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  publishProcess   NurturePublishProcess      @relation(fields: [publishProcessId], references: [id], onDelete: Restrict)
  childCareProcess NurtureChildCareProcess    @relation(fields: [childCareProcessId], references: [id], onDelete: Restrict)
  enrollment       NurtureEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  grant            NurtureChildLinkGrant      @relation(fields: [grantId], references: [id], onDelete: Restrict)
  release          NurturePublicationRelease?

  @@unique([workspaceId, publishProcessId, targetKey], map: "uq_nurture_publish_target_key")
  @@index([workspaceId, childCareProcessId], map: "ix_nurture_publish_target_process")
  @@map("nurture_publish_process_target")
}

// One expiring coordination hold per process. Not authority, not an owner and
// not a process state.
model NurturePublishEditHold {
  id                     String   @id @default(uuid())
  workspaceId            String   @map("workspace_id")
  publishProcessId       String   @unique @map("publish_process_id")
  holderRoleAssignmentId String   @map("holder_role_assignment_id")
  holderParticipantId    String   @map("holder_participant_id")
  expiresAt              DateTime @map("expires_at")
  // Floored at 1 by `ck_nurture_publish_edit_hold_version_floor`, so 0 is
  // reserved for "no live hold" — the value the `publish_edit_hold must_equal`
  // head freezes when a process carries none. Sharing 0 with a freshly created
  // hold would let an acquire prepared against absence overwrite a hold another
  // class teacher took in between.
  aggregateVersion       Int      @default(1) @map("aggregate_version")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  publishProcess NurturePublishProcess     @relation(fields: [publishProcessId], references: [id], onDelete: Restrict)
  holder         NurtureCareRoleAssignment @relation(fields: [holderRoleAssignmentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, expiresAt], map: "ix_nurture_publish_edit_hold_expiry")
  @@map("nurture_publish_edit_hold")
}

// Append-only route decisions. Structured risk codes and heads only: never a
// sensitive body, an image or model chain-of-thought.
model NurtureContentSafetyAssessment {
  id                     String                    @id @default(uuid())
  workspaceId            String                    @map("workspace_id")
  // NULL for `direct_interaction_required`: that route deliberately creates no
  // publication candidate, so the most safety-relevant decision of all had
  // nowhere to be recorded while this column was required.
  publishProcessId       String?                   @map("publish_process_id")
  // The anchor that does not depend on a process. Always set, so every
  // assessment is addressable whichever route it took.
  careGroupId            String                    @map("care_group_id")
  organizerInputRevision String                    @map("organizer_input_revision")
  route                  NurtureContentSafetyRoute
  policyRef              String                    @map("policy_ref")
  policyHead             Int                       @map("policy_head")
  ruleRevision           String                    @map("rule_revision")
  providerRevision       String?                   @map("provider_revision")
  modelRevision          String?                   @map("model_revision")
  promptPolicyRevision   String?                   @map("prompt_policy_revision")
  riskCodesPayload       Json                      @map("risk_codes_payload")
  sourceHeadsPayload     Json                      @map("source_heads_payload")
  assessedAt             DateTime                  @default(now()) @map("assessed_at")

  publishProcess NurturePublishProcess? @relation(fields: [publishProcessId], references: [id], onDelete: Restrict)
  careGroup      NurtureCareGroup       @relation(fields: [careGroupId], references: [id], onDelete: Restrict)

  @@index([workspaceId, publishProcessId, assessedAt], map: "ix_nurture_content_safety_process")
  @@index([workspaceId, careGroupId, organizerInputRevision], map: "ix_nurture_content_safety_anchor")
  @@map("nurture_content_safety_assessment")
}

// The immutable per-target committed effect, bound to the frozen revision, the
// exact authority that released it and its logical Receipt.
model NurturePublicationRelease {
  id                         String                       @id @default(uuid())
  workspaceId                String                       @map("workspace_id")
  publishProcessId           String                       @map("publish_process_id")
  publishProcessTargetId     String                       @unique @map("publish_process_target_id")
  publishProcessRevisionId   String                       @map("publish_process_revision_id")
  releasedByRoleAssignmentId String                       @map("released_by_role_assignment_id")
  commandRequestIdHash       String                       @map("command_request_id_hash")
  receiptId                  String?                      @map("receipt_id")
  visibility                 NurturePublicationVisibility @default(visible)
  committedAt                DateTime                     @default(now()) @map("committed_at")

  publishProcess           NurturePublishProcess               @relation(fields: [publishProcessId], references: [id], onDelete: Restrict)
  target                   NurturePublishProcessTarget         @relation(fields: [publishProcessTargetId], references: [id], onDelete: Restrict)
  revision                 NurturePublishProcessRevision       @relation(fields: [publishProcessRevisionId], references: [id], onDelete: Restrict)
  releasedBy               NurtureCareRoleAssignment           @relation(fields: [releasedByRoleAssignmentId], references: [id], onDelete: Restrict)
  receipt                  NurtureChildLinkReceipt?            @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  visibilityEvents         NurturePublicationVisibilityEvent[]
  familyGrowthOutboxEvents NurtureFamilyGrowthOutboxEvent[]

  // One committed release per target: `publishProcessTargetId` is already
  // `@unique`, which is what enforces it. A composite that also named the
  // command hash added nothing — the single-column unique always fires first —
  // while reading as though the command identity were part of the guarantee.
  // The replay check is explicit in `commitTargetRelease`.
  @@index([workspaceId, publishProcessId, committedAt], map: "ix_nurture_publication_release_process")
  @@map("nurture_publication_release")
}

// Append-only correction/removal/redaction lineage. It never deletes the
// release, the Receipt or the audit trail.
model NurturePublicationVisibilityEvent {
  id                    String                                @id @default(uuid())
  workspaceId           String                                @map("workspace_id")
  publicationReleaseId  String                                @map("publication_release_id")
  kind                  NurturePublicationVisibilityEventKind
  reasonKey             String                                @map("reason_key")
  actorRoleAssignmentId String                                @map("actor_role_assignment_id")
  sourceReleaseRevision Int                                   @map("source_release_revision")
  bodyProtectionPayload Json?                                 @map("body_protection_payload")
  // Both closest analogues carry this; without it the lineage cannot name the
  // command behind it and a replay has nothing to be a no-op against.
  commandExecutionId    String?                               @map("command_execution_id")
  occurredAt            DateTime                              @default(now()) @map("occurred_at")

  publicationRelease      NurturePublicationRelease       @relation(fields: [publicationReleaseId], references: [id], onDelete: Restrict)
  commandExecution        NurtureCommandExecution?        @relation(fields: [commandExecutionId], references: [id], onDelete: Restrict)
  familyGrowthOutboxEvent NurtureFamilyGrowthOutboxEvent?

  @@unique([workspaceId, publicationReleaseId, commandExecutionId, kind], map: "uq_nurture_publication_visibility_command")
  @@index([workspaceId, publicationReleaseId, occurredAt], map: "ix_nurture_publication_visibility_release")
  @@map("nurture_publication_visibility_event")
}

// T-009 provider outbox: one row per outbound family-growth contract event,
// appended in the same transaction as the fact it delivers (N5). The stored
// envelope is the single sanctioned place a canonical My-Chat child/family ID
// rests in Nurture. No network or object-storage call ever runs inside that
// transaction; the delivery worker claims committed rows afterwards.
model NurtureFamilyGrowthOutboxEvent {
  // The envelope `event_id`: the replay identity the consumer ledger
  // deduplicates on. Same id + same digest retries exactly; a different
  // digest under this id is a consumer-side `conflict`.
  id                   String                           @id
  workspaceId          String                           @map("workspace_id")
  kind                 NurtureFamilyGrowthEventKind
  publicationReleaseId String                           @map("publication_release_id")
  // Lifecycle events name the visibility fact behind them; `released` rows
  // carry NULL. Coherence is enforced by
  // `ck_nurture_family_growth_outbox_kind_source`, and `released` uniqueness
  // per release by the partial index
  // `uq_nurture_family_growth_outbox_release_once` (both migration-level:
  // Prisma cannot express partial/conditional constraints).
  visibilityEventId    String?                          @unique(map: "uq_nurture_family_growth_outbox_visibility") @map("visibility_event_id")
  payloadDigest        String                           @map("payload_digest") @db.Char(64)
  envelopePayload      Json                             @map("envelope_payload")
  deliveryState        NurtureFamilyGrowthDeliveryState @default(pending) @map("delivery_state")
  attemptCount         Int                              @default(0) @map("attempt_count")
  lastAttemptAt        DateTime?                        @map("last_attempt_at")
  nextAttemptAt        DateTime?                        @map("next_attempt_at")
  deliveredAt          DateTime?                        @map("delivered_at")
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")

  publicationRelease NurturePublicationRelease             @relation(fields: [publicationReleaseId], references: [id], onDelete: Restrict)
  visibilityEvent    NurturePublicationVisibilityEvent?    @relation(fields: [visibilityEventId], references: [id], onDelete: Restrict)
  receipts           NurtureFamilyGrowthAdmissionReceipt[]

  @@index([deliveryState, nextAttemptAt], map: "ix_nurture_family_growth_outbox_claim")
  @@index([workspaceId, publicationReleaseId, createdAt], map: "ix_nurture_family_growth_outbox_release")
  @@map("nurture_family_growth_outbox_event")
}

// Append-only store of consumed My-Chat admission receipts (N7). A receipt is
// My-Chat's processing result and delivery evidence only — it never becomes
// later Nurture read/write authority. Companion-ref requirements per status
// are enforced by `ck_nurture_family_growth_receipt_companions`.
model NurtureFamilyGrowthAdmissionReceipt {
  id             String                           @id @default(uuid())
  workspaceId    String                           @map("workspace_id")
  outboxEventId  String                           @map("outbox_event_id")
  receiptId      String                           @map("receipt_id")
  status         NurtureFamilyGrowthReceiptStatus
  admissionRef   String?                          @map("admission_ref")
  materialRef    String?                          @map("material_ref")
  suppressionRef String?                          @map("suppression_ref")
  reasonCode     String?                          @map("reason_code")
  processedAt    DateTime                         @map("processed_at")
  receiptPayload Json                             @map("receipt_payload")
  createdAt      DateTime                         @default(now()) @map("created_at")

  outboxEvent NurtureFamilyGrowthOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, outboxEventId, receiptId], map: "uq_nurture_family_growth_receipt_identity")
  @@index([workspaceId, status, processedAt], map: "ix_nurture_family_growth_receipt_status")
  @@map("nurture_family_growth_admission_receipt")
}

// G4-B increment 1 — the daily attendance closeout, frozen by 0D-1.
//
// One row per (class, date). The absence of a row IS `unsubmitted`, which is
// why the state enum carries only the two states a stored row can hold and why
// `submissionHead` starts at 1 on the first submit: a caller supplying
// `expectedSubmissionHead: 0` is asserting "this day is still unsubmitted",
// and the unique constraint below is what makes two concurrent submits
// resolve as one winner rather than two rows.
model NurtureDailyAttendanceSubmission {
  id                      String                           @id @default(uuid())
  workspaceId             String                           @map("workspace_id")
  careGroupId             String                           @map("care_group_id")
  localDate               DateTime                         @map("local_date") @db.Date
  state                   NurtureAttendanceSubmissionState
  // Monotonic. Every submit, revise and reopen increments it; a caller carries
  // the value it expects and is refused rather than merged on mismatch.
  submissionHead          Int                              @default(1) @map("submission_head")
  // The stable prefix the preview cut at, in the same shape
  // `NurtureCareCaptureBatch` already uses. Nullable until G4-B builds preview:
  // a submission made without one is honest about having none.
  watermarkSourceKind     String?                          @map("watermark_source_kind")
  watermarkSourceSequence Int?                             @map("watermark_source_sequence")

  submittedByRoleAssignmentId String    @map("submitted_by_role_assignment_id")
  submittedAt                 DateTime  @map("submitted_at")
  reopenedByRoleAssignmentId  String?   @map("reopened_by_role_assignment_id")
  reopenedAt                  DateTime? @map("reopened_at")

  aggregateVersion Int       @default(0) @map("aggregate_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  careGroup   NurtureCareGroup           @relation(fields: [careGroupId], references: [id], onDelete: Restrict)
  submittedBy NurtureCareRoleAssignment  @relation("AttendanceSubmittedBy", fields: [submittedByRoleAssignmentId], references: [id], onDelete: Restrict, map: "nurture_daily_attendance_submission_submitted_by_fkey")
  reopenedBy  NurtureCareRoleAssignment? @relation("AttendanceReopenedBy", fields: [reopenedByRoleAssignmentId], references: [id], onDelete: Restrict, map: "nurture_daily_attendance_submission_reopened_by_fkey")
  entries     NurtureAttendanceEntry[]

  // One submission per class-day. This is the concurrency rule at the storage
  // layer: the second of two racing submits loses here even if both read
  // "no row" a moment earlier.
  @@unique([workspaceId, careGroupId, localDate], map: "uq_nurture_attendance_submission_class_day")
  @@index([workspaceId, careGroupId, localDate, state], map: "ix_nurture_attendance_submission_class")
  @@map("nurture_daily_attendance_submission")
}

// One child's state within a submission. `adjustedFromInference` records that
// the teacher changed what an inference proposed — audit of the correction,
// never of the inference's accuracy.
model NurtureAttendanceEntry {
  id                    String                      @id @default(uuid())
  workspaceId           String                      @map("workspace_id")
  submissionId          String                      @map("submission_id")
  childCareProcessId    String                      @map("child_care_process_id")
  state                 NurtureAttendanceEntryState
  adjustedFromInference Boolean                     @default(false) @map("adjusted_from_inference")

  aggregateVersion Int      @default(0) @map("aggregate_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  submission       NurtureDailyAttendanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  childCareProcess NurtureChildCareProcess          @relation(fields: [childCareProcessId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, submissionId, childCareProcessId], map: "uq_nurture_attendance_entry_child")
  @@index([workspaceId, childCareProcessId, state], map: "ix_nurture_attendance_entry_child")
  @@map("nurture_attendance_entry")
}

// Audit of a non-canonical inference run. It records what was read and under
// which policy; it never holds an attendance state, because 0D-1 forbids an
// inference from producing one.
model NurtureAttendanceInferenceRun {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  careGroupId         String   @map("care_group_id")
  localDate           DateTime @map("local_date") @db.Date
  policyVersion       String   @map("policy_version")
  evidenceRefsPayload Json?    @map("evidence_refs_payload")
  generatedAt         DateTime @map("generated_at")
  createdAt           DateTime @default(now()) @map("created_at")

  careGroup NurtureCareGroup @relation(fields: [careGroupId], references: [id], onDelete: Restrict)

  @@index([workspaceId, careGroupId, localDate], map: "ix_nurture_attendance_inference_class")
  @@map("nurture_attendance_inference_run")
}

// G4-B increment 4 — class schedule and activity placement, frozen by 0D-2.
//
// The institution default and the class standing override share one table:
// they differ only in whether `careGroupId` is set, and splitting them would
// duplicate the slot shape and let the two drift.
//
// Slots live in JSON because they are a list whose only consumer is the
// resolver, and because a slot is not addressable on its own — 0D-2 resolves a
// whole layer or none of it.
model NurtureClassScheduleTemplate {
  id            String                    @id @default(uuid())
  workspaceId   String                    @map("workspace_id")
  institutionId String                    @map("institution_id")
  // NULL means the institution default; set means that class's standing
  // override. The partial unique indexes below keep exactly one live row per
  // scope.
  careGroupId   String?                   @map("care_group_id")
  layer         NurtureClassScheduleLayer
  // [{ slotRef, label, startsAt, endsAt, activityRef? }] — see 0D-2 §3.
  slotsPayload  Json                      @map("slots_payload")

  aggregateVersion Int       @default(0) @map("aggregate_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  // Part of the effective schedule's version, which is the max updatedAt over
  // the layers that could resolve. Soft deletion touches this too, so removing
  // a layer advances the version rather than moving it backwards.
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  institution NurtureCareInstitution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  careGroup   NurtureCareGroup?      @relation(fields: [careGroupId], references: [id], onDelete: Restrict)

  @@index([workspaceId, institutionId, layer], map: "ix_nurture_class_schedule_template_scope")
  @@map("nurture_class_schedule_template")
}

// The day's override — the highest-precedence layer, and the only one keyed to
// a date.
model NurtureClassScheduleDayOverride {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  careGroupId  String   @map("care_group_id")
  localDate    DateTime @map("local_date") @db.Date
  slotsPayload Json     @map("slots_payload")

  aggregateVersion Int       @default(0) @map("aggregate_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  careGroup NurtureCareGroup @relation(fields: [careGroupId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, careGroupId, localDate], map: "uq_nurture_class_schedule_day_override")
  @@map("nurture_class_schedule_day_override")
}

// Where a source sits. Its own row rather than a column on the capture, so a
// source can be re-placed without touching the teacher's original (0D-3).
model NurtureActivityPlacement {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  // Polymorphic by design: 0D-2 places captures and daily care logs, which
  // have no common parent. The pair is unique so one source has one placement.
  sourceKind  String   @map("source_kind")
  sourceId    String   @map("source_id")
  // Always the source's own class. An uncertain source stays here as
  // `unplaced` rather than moving anywhere.
  careGroupId String   @map("care_group_id")
  localDate   DateTime @map("local_date") @db.Date

  state         NurtureActivityPlacementState
  // The slot the source sits in. NULL exactly when state is `unplaced`.
  activityRef   String?                           @map("activity_ref")
  decidedBy     NurtureActivityPlacementDecidedBy @map("decided_by")
  // Monotonic; every change increments, including a move to `unplaced`.
  placementHead Int                               @default(1) @map("placement_head")

  aggregateVersion Int      @default(0) @map("aggregate_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  careGroup NurtureCareGroup @relation(fields: [careGroupId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, sourceKind, sourceId], map: "uq_nurture_activity_placement_source")
  @@index([workspaceId, careGroupId, localDate, state], map: "ix_nurture_activity_placement_class_day")
  @@map("nurture_activity_placement")
}

// G4-C 0D-3 — the append-only Admin revision chain. The teacher's original
// body, media, author and source time remain on their canonical owner rows and
// are never copied here. Placement keeps a mutable current projection for
// 0D-2 reads, but its only Admin writer appends one of these rows atomically
// with advancing that projection.
model NurtureContentRevision {
  id                    String                             @id @default(uuid())
  workspaceId           String                             @map("workspace_id")
  // A typed canonical string issued by the repository, never a caller value:
  // nurture:<care_capture|media_asset_ref|activity_placement>:<id>.
  subjectRef            String                             @map("subject_ref")
  subjectKind           NurtureContentRevisionSubjectKind  @map("subject_kind")
  previousValue         Json                               @map("previous_value")
  newValue              Json                               @map("new_value")
  decidedByBefore       NurtureActivityPlacementDecidedBy? @map("decided_by_before")
  actorRoleAssignmentId String                             @map("actor_role_assignment_id")
  reason                String                             @db.Text
  supersedesRef         String?                            @unique(map: "uq_nurture_content_revision_supersedes") @map("supersedes_ref")
  revisionHead          Int                                @map("revision_head")
  commandRequestIdHash  String                             @map("command_request_id_hash") @db.Char(64)
  contractVersion       String                             @map("contract_version")
  occurredAt            DateTime                           @default(now()) @map("occurred_at")

  actorRoleAssignment NurtureCareRoleAssignment @relation(fields: [actorRoleAssignmentId], references: [id], onDelete: Restrict)
  supersedes          NurtureContentRevision?   @relation("ContentRevisionSupersession", fields: [supersedesRef], references: [id], onDelete: Restrict)
  supersededBy        NurtureContentRevision[]  @relation("ContentRevisionSupersession")

  @@unique([workspaceId, subjectKind, subjectRef, revisionHead], map: "uq_nurture_content_revision_head")
  @@unique([workspaceId, commandRequestIdHash], map: "uq_nurture_content_revision_request")
  @@index([workspaceId, subjectKind, subjectRef, occurredAt], map: "ix_nurture_content_revision_subject")
  @@index([workspaceId, actorRoleAssignmentId, occurredAt], map: "ix_nurture_content_revision_actor")
  @@map("nurture_content_revision")
}

// G4-C 0D-4 — a non-canonical, append-only report that one exact attribution
// revision may be wrong. It has deliberately no status, head, expiry,
// resolution or proposed-child field: only a current exact caregiver may act,
// and they do so through T-006's canonical attribution capability.
model NurtureAttributionCorrectionCandidate {
  id                       String   @id @default(uuid())
  workspaceId              String   @map("workspace_id")
  sourceAttributionId      String   @map("source_attribution_id")
  raisedByRoleAssignmentId String   @map("raised_by_role_assignment_id")
  reason                   String   @db.Text
  commandRequestIdHash     String   @map("command_request_id_hash") @db.Char(64)
  contractVersion          String   @map("contract_version")
  occurredAt               DateTime @default(now()) @map("occurred_at")

  sourceAttribution NurtureChildMediaAttribution @relation(fields: [sourceAttributionId], references: [id], onDelete: Restrict)
  raisedBy          NurtureCareRoleAssignment    @relation(fields: [raisedByRoleAssignmentId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, commandRequestIdHash], map: "uq_nurture_attribution_correction_request")
  @@index([workspaceId, sourceAttributionId, occurredAt], map: "ix_nurture_attribution_correction_source")
  @@index([workspaceId, raisedByRoleAssignmentId, occurredAt], map: "ix_nurture_attribution_correction_actor")
  @@map("nurture_attribution_correction_candidate")
}

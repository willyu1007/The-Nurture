{
  "name": "the-nurture",
  "version": "0.1.0",
  "description": "My-Chat framework scenario module for pregnancy, motherhood, childcare, family strategy, activity comparison, and review-driven parenting workflows.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "prepare:pinned-source": "pnpm verify:workflow-contract-pin && pnpm build:pinned-workflow-contracts",
    "build:pinned-workflow-contracts": "pnpm exec tsc -p ../My-Chat/packages/workflow-contracts/tsconfig.json --typeRoots ./node_modules/@types",
    "build": "pnpm prepare:pinned-source && pnpm typecheck && pnpm build:scenario-service && pnpm --filter @the-nurture/frontend build",
    "dev": "node scripts/run-with-local-env.mjs pnpm --filter @the-nurture/scenario-service dev",
    "dev:frontend": "pnpm --filter @the-nurture/frontend dev",
    "lint": "pnpm prepare:pinned-source && pnpm --filter @the-nurture/frontend lint",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:ci": "vitest run -c vitest.config.ts --reporter=json --outputFile=.ai/.tmp/test-results/unit.json",
    "test:db": "pnpm build:binding-owner-runtime && node scripts/run-with-local-env.mjs pnpm exec vitest run -c vitest.db.config.ts",
    "test:db:ci": "pnpm build:binding-owner-runtime && node scripts/run-with-local-env.mjs pnpm exec vitest run -c vitest.db.config.ts --reporter=json --outputFile=.ai/.tmp/test-results/production-db.json",
    "test:scenario-service": "pnpm --filter @the-nurture/scenario-service test",
    "test:scenario-service:db": "pnpm --filter @the-nurture/scenario-service test:db",
    "test:surface-contract-tooling": "node --test scripts/surface-contract/contract-core.test.mjs",
    "typecheck:scenario-service:db": "pnpm --filter @the-nurture/scenario-service typecheck:db",
    "test:x5": "pnpm exec vitest run -c vitest.x5.config.ts",
    "test:local-env-runner": "node --test scripts/run-with-local-env.test.mjs",
    "test:all": "pnpm test:unit && pnpm test:scenario-service && pnpm test:db",
    "build:scenario-service": "pnpm --filter @the-nurture/scenario-service build",
    "build:binding-owner-runtime": "pnpm --filter @the-nurture/scenario build && pnpm --filter @the-nurture/db build",
    "build:surface-contract": "node scripts/surface-contract/build-surface-contract.mjs",
    "smoke:scenario-service": "node scripts/smoke-scenario-service.mjs",
    "typecheck": "pnpm build:pinned-workflow-contracts && pnpm db:generate:all && tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "node scripts/run-with-local-env.mjs pnpm exec prisma generate --schema prisma/schema.prisma",
    "db:validate": "node scripts/run-with-local-env.mjs pnpm exec prisma validate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/run-with-local-env.mjs pnpm exec prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node scripts/run-with-local-env.mjs pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:context": "node .ai/scripts/ctl-db-ssot.mjs sync-to-context",
    "db:assert-boundary": "node scripts/run-with-local-env.mjs node scripts/assert-production-db-boundary.mjs",
    "db:generate:all": "pnpm db:generate",
    "db:migrate:all": "pnpm db:migrate",
    "verify:unit-population": "node scripts/assert-vitest-population.mjs .ai/.tmp/test-results/unit.json unit 1133",
    "verify:db-population": "node scripts/assert-vitest-population.mjs .ai/.tmp/test-results/production-db.json production-db 499",
    "verify:test-routing": "node scripts/assert-test-routing.mjs",
    "verify:family-sharing-invariants": "node scripts/assert-family-sharing-invariants.mjs",
    "verify:family-growth-outbox-invariants": "node scripts/assert-family-growth-outbox-invariants.mjs",
    "verify:persistence-boundaries": "node scripts/assert-persistence-boundaries.mjs",
    "verify:parent-context-presenter-contract": "tsx packages/nurture-scenario/contracts/parent-context-presenter/v1/validate-contract.mjs",
    "verify:parent-communication-owner-contract": "tsx packages/nurture-scenario/contracts/parent-communication-owner/v1/validate-contract.mjs",
    "verify:director-presenter-contract": "tsx packages/nurture-scenario/contracts/director-presenter/v1/validate-contract.mjs",
    "verify:teacher-class-stream-contract": "tsx packages/nurture-scenario/contracts/teacher-class-stream/v1/validate-contract.mjs",
    "verify:teacher-organization-owner-contract": "tsx packages/nurture-scenario/contracts/teacher-organization-owner/v1/validate-contract.mjs",
    "verify:teacher-communication-owner-contract": "tsx packages/nurture-scenario/contracts/teacher-communication-owner/v1/validate-contract.mjs",
    "verify:teacher-media-association-owner-contract": "tsx packages/nurture-scenario/contracts/teacher-media-association-owner/v1/validate-contract.mjs",
    "verify:teacher-assistant-query-owner-contract": "tsx packages/nurture-scenario/contracts/teacher-assistant-query-owner/v1/validate-contract.mjs",
    "verify:parent-communication-extension-contract": "tsx packages/nurture-scenario/contracts/parent-communication-owner/v1-1/validate-contract.mjs",
    "verify:formal-ingress-contract": "pnpm verify:parent-context-presenter-contract && pnpm verify:parent-communication-owner-contract && pnpm verify:parent-communication-extension-contract && pnpm verify:director-presenter-contract && pnpm verify:teacher-class-stream-contract && pnpm verify:teacher-organization-owner-contract && pnpm verify:teacher-communication-owner-contract && pnpm verify:teacher-media-association-owner-contract && pnpm verify:teacher-assistant-query-owner-contract && node scripts/assert-formal-ingress-contract.mjs",
    "verify:g2-exit-contract": "node scripts/assert-g2-exit-contract.mjs",
    "verify:g2-exit-db-census": "node scripts/assert-g2-exit-db-census.mjs",
    "verify:g3-0-freeze": "node scripts/assert-g3-0-freeze.mjs",
    "verify:port-topology": "node scripts/assert-port-topology.mjs",
    "verify:surface-conformance": "node scripts/surface-contract/run-surface-conformance.mjs",
    "verify:owner-integration": "node scripts/surface-contract/run-owner-integration.mjs",
    "verify:surface-contract": "node scripts/surface-contract/verify-surface-contract.mjs",
    "verify:surface-contract-schemas": "node scripts/surface-contract/validate-surface-contract-schemas.mjs",
    "build:institution-knowledge-safety-qualification": "node scripts/institution-knowledge-safety/qualification-core.mjs --write",
    "verify:institution-knowledge-safety-qualification": "node scripts/institution-knowledge-safety/qualification-core.mjs --check",
    "test:institution-knowledge-safety-qualification": "node --test scripts/institution-knowledge-safety/qualification-core.test.mjs",
    "verify:n1-schema-contract": "node scripts/assert-n1-schema-contract.mjs",
    "verify:x4-handoff-replay-contract": "node scripts/assert-x4-handoff-replay-contract.mjs",
    "test:workflow-contract-pin": "node --test scripts/verify-workflow-contract-pin.test.mjs",
    "verify:workflow-contract-pin": "node scripts/verify-workflow-contract-pin.mjs",
    "reseal:pins": "node scripts/reseal-cross-repo-pins.mjs",
    "test:reseal-pins": "node --test scripts/reseal-cross-repo-pins.test.mjs",
    "verify:c30-i3-upstream": "node scripts/verify-c30-i3-upstream.mjs",
    "verify:c30-i3-default-off": "node scripts/verify-c30-i3-default-off.mjs",
    "hash:c30-i3-owner-adoption": "node scripts/compute-c30-i3-owner-adoption-hash.mjs",
    "verify:c30-i3-owner-adoption": "node scripts/compute-c30-i3-owner-adoption-hash.mjs --check docs/project/integrations/c30-i3-owner-adoption-lock.json"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "^16.4.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "@my-chat/api": "link:../My-Chat/apps/api",
      "@my-chat/db": "link:../My-Chat/packages/db",
      "@my-chat/domain": "link:../My-Chat/packages/domain",
      "@my-chat/llm": "link:../My-Chat/packages/llm",
      "@my-chat/outbox": "link:../My-Chat/packages/outbox",
      "@my-chat/rag": "link:../My-Chat/packages/rag",
      "@my-chat/permissions": "link:../My-Chat/packages/permissions",
      "@my-chat/scenario-integrations": "link:../My-Chat/packages/scenario-integrations",
      "@my-chat/workers": "link:../My-Chat/apps/workers",
      "@my-chat/workflow-contracts": "link:../My-Chat/packages/workflow-contracts",
      "@my-chat/workflow-runtime": "link:../My-Chat/packages/workflow-runtime"
    }
  }
}

{
  "name": "@the-nurture/scenario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Nurture scenario module scaffold compatible with My-Workflow-Base contracts.",
  "exports": {
    ".": "./src/index.ts",
    "./binding-owner": {
      "types": "./src/binding-owner.ts",
      "import": "./dist/binding-owner.js",
      "default": "./dist/binding-owner.js"
    },
    "./binding-owner-http": {
      "types": "./src/binding-owner-http.ts",
      "import": "./dist/binding-owner-http.js",
      "default": "./dist/binding-owner-http.js"
    },
    "./harness": {
      "types": "./src/harness-entry.ts",
      "import": "./dist/harness-entry.js",
      "default": "./dist/harness-entry.js"
    },
    "./family-growth": {
      "types": "./src/family-growth.ts",
      "import": "./dist/family-growth.js",
      "default": "./dist/family-growth.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "generate:manifest": "node ../../scripts/generate-nurture-scenario-manifest.mjs",
    "check:manifest": "node ../../scripts/generate-nurture-scenario-manifest.mjs --check",
    "build": "pnpm run check:manifest && pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run check:manifest && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@my-chat/workflow-contracts": "0.1.0"
  },
  "devDependencies": {
    "@my-chat/workflow-runtime": "0.1.0"
  }
}

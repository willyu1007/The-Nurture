{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/correct-family-care-message.schema.json",
  "title": "CorrectFamilyCareMessageV1",
  "$defs": {
    "input": {
      "$ref": "family-care-types.schema.json#/$defs/protectedTextInput"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "messageRef",
        "correctionRef",
        "receiptRef"
      ],
      "properties": {
        "effect": {
          "const": "correction_appended"
        },
        "messageRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "correctionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "receiptRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/organize-care-capture-batch.schema.json",
  "title": "OrganizeCareCaptureBatchV1",
  "$defs": {
    "input": {
      "$ref": "publish-process-types.schema.json#/$defs/emptyInput"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchRef",
        "outcome",
        "watermarkSequence",
        "includedCaptureCount",
        "deferredCaptureCount"
      ],
      "properties": {
        "batchRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "outcome": {
          "enum": [
            "organized",
            "nothing_to_organize"
          ]
        },
        "processRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "watermarkSequence": {
          "type": "integer",
          "minimum": 0
        },
        "includedCaptureCount": {
          "type": "integer",
          "minimum": 0
        },
        "deferredCaptureCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

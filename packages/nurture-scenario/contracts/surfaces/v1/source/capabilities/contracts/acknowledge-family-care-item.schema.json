{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/acknowledge-family-care-item.schema.json",
  "title": "AcknowledgeFamilyCareItemV1",
  "$defs": {
    "input": {
      "$ref": "family-care-types.schema.json#/$defs/emptyInput"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "careItemRef",
        "receiptRef"
      ],
      "properties": {
        "effect": {
          "enum": [
            "acknowledged",
            "already_satisfied"
          ]
        },
        "careItemRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "receiptRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/institution-knowledge-actions.schema.json",
  "title": "InstitutionKnowledgeActionsV1",
  "$defs": {
    "authoringMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intendedAudiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "institution-knowledge-types.schema.json#/$defs/audience"
          }
        },
        "ageBandKeys": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/tokenList"
        },
        "scenarioKeys": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/tokenList"
        },
        "safetyClass": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/safetyClass"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "authoritySourceOptionRefs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
          }
        }
      }
    },
    "createItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "body",
        "intendedAudiences",
        "safetyClass"
      ],
      "properties": {
        "category": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/category"
        },
        "body": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/body"
        },
        "intendedAudiences": {
          "$ref": "#/$defs/authoringMetadata/properties/intendedAudiences"
        },
        "ageBandKeys": {
          "$ref": "#/$defs/authoringMetadata/properties/ageBandKeys"
        },
        "scenarioKeys": {
          "$ref": "#/$defs/authoringMetadata/properties/scenarioKeys"
        },
        "safetyClass": {
          "$ref": "#/$defs/authoringMetadata/properties/safetyClass"
        },
        "validFrom": {
          "$ref": "#/$defs/authoringMetadata/properties/validFrom"
        },
        "validUntil": {
          "$ref": "#/$defs/authoringMetadata/properties/validUntil"
        },
        "authoritySourceOptionRefs": {
          "$ref": "#/$defs/authoringMetadata/properties/authoritySourceOptionRefs"
        }
      }
    },
    "createRevisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "intendedAudiences",
        "safetyClass"
      ],
      "properties": {
        "body": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/body"
        },
        "intendedAudiences": {
          "$ref": "#/$defs/authoringMetadata/properties/intendedAudiences"
        },
        "ageBandKeys": {
          "$ref": "#/$defs/authoringMetadata/properties/ageBandKeys"
        },
        "scenarioKeys": {
          "$ref": "#/$defs/authoringMetadata/properties/scenarioKeys"
        },
        "safetyClass": {
          "$ref": "#/$defs/authoringMetadata/properties/safetyClass"
        },
        "validFrom": {
          "$ref": "#/$defs/authoringMetadata/properties/validFrom"
        },
        "validUntil": {
          "$ref": "#/$defs/authoringMetadata/properties/validUntil"
        },
        "authoritySourceOptionRefs": {
          "$ref": "#/$defs/authoringMetadata/properties/authoritySourceOptionRefs"
        }
      }
    },
    "reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reasonKey"
      ],
      "properties": {
        "decision": {
          "enum": [
            "reviewed",
            "changes_requested"
          ]
        },
        "reasonKey": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/token"
        }
      }
    },
    "publishInput": {
      "type": "object",
      "additionalProperties": false
    },
    "revokeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonKey"
      ],
      "properties": {
        "reasonKey": {
          "$ref": "institution-knowledge-types.schema.json#/$defs/token"
        }
      }
    },
    "actionResult": {
      "$ref": "institution-knowledge-types.schema.json#/$defs/actionResult"
    }
  }
}

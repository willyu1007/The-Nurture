{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/reply-family-care-item.schema.json",
  "title": "ReplyFamilyCareItemV1",
  "$defs": {
    "input": {
      "$ref": "family-care-types.schema.json#/$defs/protectedTextInput"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "careItemRef",
        "messageRef",
        "receiptRef",
        "responseEffect",
        "attentionEffect"
      ],
      "properties": {
        "effect": {
          "const": "reply_appended"
        },
        "careItemRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "messageRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "receiptRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "responseEffect": {
          "enum": [
            "first_response",
            "additional_response"
          ]
        },
        "attentionEffect": {
          "enum": [
            "resolved",
            "unchanged"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/update-guardian-current-focus.schema.json",
  "title": "UpdateGuardianCurrentFocusV1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "priority"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusGoalRef",
        "revision",
        "scopeSource"
      ],
      "properties": {
        "focusGoalRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scopeSource": {
          "enum": [
            "family_scope",
            "explicit_child_scope"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/save-publish-process-draft.schema.json",
  "title": "SavePublishProcessDraftV1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedDraftRevision",
        "title",
        "segments"
      ],
      "properties": {
        "expectedDraftRevision": {
          "description": "The draft revision this save was composed against, as the client observed it (D-08). 0 means the process has no saved revision yet. The owner conflicts on mismatch; a save that omits the client's base would let the server compare its own head to itself and silently last-write-win.",
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "segments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceRef": {
                "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processRef",
        "revision",
        "savedAt"
      ],
      "properties": {
        "processRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revision": {
          "$ref": "publish-process-types.schema.json#/$defs/draftRevision"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

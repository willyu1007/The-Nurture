{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/save-publish-process-draft.schema.json",
  "title": "SavePublishProcessDraftV1",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "segments"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "segments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sourceRef": {
                "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processRef",
        "revision",
        "savedAt"
      ],
      "properties": {
        "processRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revision": {
          "$ref": "publish-process-types.schema.json#/$defs/draftRevision"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}

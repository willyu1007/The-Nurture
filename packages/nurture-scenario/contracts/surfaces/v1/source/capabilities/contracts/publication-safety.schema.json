{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/publication-safety.schema.json",
  "title": "PublicationSafetyV1",
  "$defs": {
    "reason": {
      "enum": [
        "wrong_target",
        "wrong_media",
        "wrong_attribution",
        "content_error",
        "family_request",
        "policy_requirement"
      ]
    },
    "correctInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "correctionText"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/reason" },
        "correctionText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "removeTargetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "publicationRef"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/reason" },
        "publicationRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        }
      }
    },
    "redactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": { "$ref": "#/$defs/reason" }
      }
    },
    "safetyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/visibilityEvent"
          }
        }
      }
    },
    "visibilityEvent": {
      "description": "Append-only lineage. The release, its Receipt and the CommandExecution are preserved.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventRef",
        "kind",
        "reason",
        "occurredAt",
        "publicationRef",
        "preservedReceiptRef",
        "sourceReleaseRevision"
      ],
      "properties": {
        "eventRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "kind": {
          "enum": [
            "correction",
            "target_removal",
            "redaction"
          ]
        },
        "reason": { "$ref": "#/$defs/reason" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "publicationRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "preservedReceiptRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "sourceReleaseRevision": {
          "$ref": "publish-process-types.schema.json#/$defs/draftRevision"
        }
      }
    }
  }
}

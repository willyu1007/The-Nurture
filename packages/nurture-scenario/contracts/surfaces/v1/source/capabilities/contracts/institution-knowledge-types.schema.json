{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/capabilities/contracts/institution-knowledge-types.schema.json",
  "title": "InstitutionKnowledgeContractTypesV1",
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
    },
    "tokenList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,199}$"
    },
    "category": {
      "enum": [
        "child_communication_development",
        "daily_care_safety",
        "institution_policy",
        "activity_resource",
        "guardian_communication",
        "basic_health_first_aid"
      ]
    },
    "safetyClass": {
      "enum": [
        "general_guidance",
        "care_safety",
        "basic_health_first_aid"
      ]
    },
    "audience": {
      "enum": [
        "institution_admin",
        "caregiver",
        "guardian"
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "sections"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sectionKey",
              "heading",
              "body"
            ],
            "properties": {
              "sectionKey": {
                "$ref": "#/$defs/token"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "revisionState": {
      "enum": [
        "draft",
        "published",
        "superseded",
        "revoked"
      ]
    },
    "actionEffect": {
      "enum": [
        "create_institution_knowledge_item",
        "create_institution_knowledge_revision",
        "record_institution_knowledge_review",
        "publish_institution_knowledge_revision",
        "revoke_institution_knowledge_revision"
      ]
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "itemOptionRef",
        "revisionOptionRef",
        "itemHead",
        "revisionNumber",
        "revisionState",
        "committedAt"
      ],
      "properties": {
        "effect": {
          "$ref": "#/$defs/actionEffect"
        },
        "itemOptionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revisionOptionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "itemHead": {
          "type": "integer",
          "minimum": 1
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "revisionState": {
          "$ref": "#/$defs/revisionState"
        },
        "committedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "previewWarning": {
      "enum": [
        "draft",
        "superseded",
        "unreviewed",
        "not_yet_valid",
        "expired",
        "authority_source_invalid"
      ]
    },
    "previewOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisionOptionRef",
        "sourceRef",
        "sourceVersion",
        "revisionNumber",
        "state",
        "body",
        "warnings"
      ],
      "properties": {
        "revisionOptionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "sourceRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "sourceVersion": {
          "$ref": "#/$defs/sourceVersion"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "draft",
            "published",
            "superseded"
          ]
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/previewWarning"
          }
        }
      }
    },
    "claimKind": {
      "enum": [
        "institution_process",
        "developmental_guidance",
        "care_guidance",
        "medical_fact",
        "first_aid_action",
        "danger_signal"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "claimKind",
        "citationRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "claimKind": {
          "$ref": "#/$defs/claimKind"
        },
        "citationRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
          }
        }
      }
    },
    "safetyReason": {
      "enum": [
        "child_specific_or_private_fact",
        "person_specific_diagnosis",
        "prescriptive_medication_or_dose",
        "emergency_replacement",
        "unsupported_deterministic_step"
      ]
    },
    "safetyNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonKeys"
      ],
      "properties": {
        "reasonKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "not_a_diagnosis",
              "not_a_prescription",
              "not_emergency_replacement",
              "seek_qualified_medical_help",
              "remove_child_specific_details"
            ]
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationRef",
        "sourceRef",
        "sourceVersion",
        "contentHash",
        "sourceKind",
        "label",
        "provenanceKind",
        "title",
        "excerpt"
      ],
      "properties": {
        "citationRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "sourceRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "sourceVersion": {
          "$ref": "#/$defs/sourceVersion"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "sourceKind": {
          "enum": [
            "institution_material",
            "authority_source"
          ]
        },
        "label": {
          "enum": [
            "园区材料",
            "权威来源"
          ]
        },
        "provenanceKind": {
          "enum": [
            "institution_authored",
            "authority_source"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "openRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "itemOptionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revisionOptionRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 1
        },
        "publicationEventRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceDate": {
          "type": "string",
          "format": "date"
        }
      },
      "oneOf": [
        {
          "properties": {
            "sourceKind": {
              "const": "institution_material"
            },
            "label": {
              "const": "园区材料"
            },
            "provenanceKind": {
              "const": "institution_authored"
            }
          },
          "required": [
            "itemOptionRef",
            "revisionOptionRef",
            "revisionNumber",
            "publicationEventRef",
            "publishedAt"
          ],
          "not": {
            "anyOf": [
              { "required": ["publisher"] },
              { "required": ["sourceDate"] }
            ]
          }
        },
        {
          "properties": {
            "sourceKind": {
              "const": "authority_source"
            },
            "label": {
              "const": "权威来源"
            },
            "provenanceKind": {
              "const": "authority_source"
            }
          },
          "required": [
            "publisher",
            "sourceDate"
          ],
          "not": {
            "anyOf": [
              { "required": ["itemOptionRef"] },
              { "required": ["revisionOptionRef"] },
              { "required": ["revisionNumber"] },
              { "required": ["publicationEventRef"] },
              { "required": ["publishedAt"] }
            ]
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictClass",
        "findingFingerprint",
        "candidateRef",
        "citationRefs"
      ],
      "properties": {
        "conflictClass": {
          "enum": [
            "contradictory_action",
            "contradictory_sequence",
            "contradictory_escalation",
            "contraindication_conflict"
          ]
        },
        "findingFingerprint": {
          "$ref": "#/$defs/hash"
        },
        "candidateRef": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
        },
        "citationRefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../../interface/contract-primitives.schema.json#/$defs/opaqueRef"
          }
        }
      }
    }
  }
}

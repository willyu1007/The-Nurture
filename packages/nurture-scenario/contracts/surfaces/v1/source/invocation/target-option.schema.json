{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/invocation/target-option.schema.json",
  "title": "OwnerTargetOptionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetOptionRef",
    "label",
    "expiresAt"
  ],
  "properties": {
    "targetOptionRef": {
      "$ref": "../interface/contract-primitives.schema.json#/$defs/opaqueRef"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/fixtures/world/synthetic-world.schema.json",
  "title": "SyntheticWorldV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worldKey",
    "worldVersion",
    "participants",
    "families",
    "children",
    "childCareProcesses",
    "institutions",
    "careGroups",
    "caregiverAssignments",
    "enrollments",
    "familyCareGrants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "worldKey": { "$ref": "#/$defs/worldKey" },
    "worldVersion": { "$ref": "#/$defs/semver" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/participant" }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/family" }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/childRecord" }
    },
    "childCareProcesses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/childCareProcess" }
    },
    "institutions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/institution" }
    },
    "careGroups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/careGroup" }
    },
    "caregiverAssignments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caregiverAssignment" }
    },
    "enrollments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/enrollment" }
    },
    "familyCareGrants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/familyCareGrant" }
    }
  },
  "$defs": {
    "syntheticId": {
      "type": "string",
      "pattern": "^syn-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "syntheticLabel": {
      "type": "string",
      "pattern": "^Syn(?: [A-Z][a-z0-9]+)+$",
      "maxLength": 64
    },
    "worldKey": {
      "type": "string",
      "pattern": "^world-v[0-9]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "displayLabel"],
      "properties": {
        "participantId": { "$ref": "#/$defs/syntheticId" },
        "displayLabel": { "$ref": "#/$defs/syntheticLabel" }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "guardianParticipantIds"],
      "properties": {
        "familyId": { "$ref": "#/$defs/syntheticId" },
        "guardianParticipantIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/syntheticId" }
        }
      }
    },
    "childRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childId", "familyId", "displayLabel", "identityBindingState"],
      "properties": {
        "childId": { "$ref": "#/$defs/syntheticId" },
        "familyId": { "$ref": "#/$defs/syntheticId" },
        "displayLabel": { "$ref": "#/$defs/syntheticLabel" },
        "identityBindingState": { "enum": ["bound", "provisional"] }
      }
    },
    "childCareProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "childId"],
      "properties": {
        "processId": { "$ref": "#/$defs/syntheticId" },
        "childId": { "$ref": "#/$defs/syntheticId" }
      }
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutionId", "displayLabel"],
      "properties": {
        "institutionId": { "$ref": "#/$defs/syntheticId" },
        "displayLabel": { "$ref": "#/$defs/syntheticLabel" }
      }
    },
    "careGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["careGroupId", "institutionId", "displayLabel"],
      "properties": {
        "careGroupId": { "$ref": "#/$defs/syntheticId" },
        "institutionId": { "$ref": "#/$defs/syntheticId" },
        "displayLabel": { "$ref": "#/$defs/syntheticLabel" }
      }
    },
    "caregiverAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "participantId", "careGroupId", "actorRole", "state"],
      "properties": {
        "assignmentId": { "$ref": "#/$defs/syntheticId" },
        "participantId": { "$ref": "#/$defs/syntheticId" },
        "careGroupId": { "$ref": "#/$defs/syntheticId" },
        "actorRole": { "enum": ["caregiver", "lead_caregiver"] },
        "state": { "enum": ["active"] }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enrollmentId", "processId", "institutionId", "careGroupId", "state"],
      "properties": {
        "enrollmentId": { "$ref": "#/$defs/syntheticId" },
        "processId": { "$ref": "#/$defs/syntheticId" },
        "institutionId": { "$ref": "#/$defs/syntheticId" },
        "careGroupId": { "$ref": "#/$defs/syntheticId" },
        "state": { "enum": ["active"] }
      }
    },
    "familyCareGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantId", "enrollmentId", "familyId", "purposeKey", "state"],
      "properties": {
        "grantId": { "$ref": "#/$defs/syntheticId" },
        "enrollmentId": { "$ref": "#/$defs/syntheticId" },
        "familyId": { "$ref": "#/$defs/syntheticId" },
        "purposeKey": { "enum": ["family_care_interaction"] },
        "state": { "enum": ["current"] }
      }
    },
    "pilotProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profileKey",
        "worldKey",
        "selectedInstitutionId",
        "writeTargetResolution"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "profileKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "worldKey": { "$ref": "#/$defs/worldKey" },
        "selectedInstitutionId": { "$ref": "#/$defs/syntheticId" },
        "writeTargetResolution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processId", "enrollmentId"],
            "properties": {
              "processId": { "$ref": "#/$defs/syntheticId" },
              "enrollmentId": { "$ref": "#/$defs/syntheticId" }
            }
          }
        }
      }
    }
  }
}

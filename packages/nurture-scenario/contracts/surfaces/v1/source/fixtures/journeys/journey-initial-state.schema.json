{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/fixtures/journeys/journey-initial-state.schema.json",
  "title": "JourneyInitialStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeyKey", "worldRef", "actorSet", "overlay"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journeyKey": { "$ref": "#/$defs/journeyKey" },
    "worldRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldKey", "worldVersion"],
      "properties": {
        "worldKey": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/worldKey"
        },
        "worldVersion": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/semver"
        }
      }
    },
    "actorSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalParticipants",
        "institutionAdminAssignments",
        "additionalFamilyCareGrants",
        "preexistingCareItems"
      ],
      "properties": {
        "additionalParticipants": {
          "type": "array",
          "items": {
            "$ref": "../world/synthetic-world.schema.json#/$defs/participant"
          }
        },
        "institutionAdminAssignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/institutionAdminAssignment" }
        },
        "additionalFamilyCareGrants": {
          "type": "array",
          "items": {
            "$ref": "../world/synthetic-world.schema.json#/$defs/familyCareGrant"
          }
        },
        "preexistingCareItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/preexistingCareItem" }
        }
      }
    }
  },
  "$defs": {
    "journeyKey": {
      "type": "string",
      "pattern": "^(?:gj|rj)-[1-9]$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "actorRole"],
      "properties": {
        "participantId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "actorRole": {
          "enum": ["guardian", "caregiver", "lead_caregiver", "institution_admin"]
        }
      }
    },
    "institutionAdminAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "participantId", "institutionId"],
      "properties": {
        "assignmentId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "participantId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "institutionId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        }
      }
    },
    "preexistingCareItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "enrollmentId", "submittedByParticipantId", "state"],
      "properties": {
        "itemId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "enrollmentId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "submittedByParticipantId": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "state": { "enum": ["submitted", "acknowledged", "responded"] }
      }
    }
  }
}

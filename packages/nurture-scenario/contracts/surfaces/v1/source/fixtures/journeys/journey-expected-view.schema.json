{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.the-nurture.local/surfaces/v1/source/fixtures/journeys/journey-expected-view.schema.json",
  "title": "JourneyExpectedViewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "journeyKey",
    "stepKey",
    "surfaceKey",
    "actor",
    "surfaceState",
    "careItems",
    "writeActionKeys"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journeyKey": {
      "$ref": "journey-initial-state.schema.json#/$defs/journeyKey"
    },
    "stepKey": { "$ref": "journey-script.schema.json#/$defs/stepKey" },
    "surfaceKey": { "$ref": "journey-script.schema.json#/$defs/surfaceKey" },
    "actor": { "$ref": "journey-script.schema.json#/$defs/principalActor" },
    "surfaceState": {
      "enum": ["ready", "limited", "needs_setup", "unavailable"]
    },
    "careItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/careItemView" }
    },
    "writeActionKeys": {
      "type": "array",
      "items": {
        "$ref": "journey-script.schema.json#/$defs/actionCapabilityKey"
      }
    },
    "boardModules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boardModuleView" }
    },
    "absentModuleKinds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boardModuleKind" }
    },
    "dependencyNoGos": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependencyNoGoView" }
    }
  },
  "$defs": {
    "boardModuleKind": {
      "enum": [
        "guardian_current_focus",
        "guardian_enrollment_activity",
        "caregiver_child_today",
        "caregiver_family_care_work",
        "teacher_publish_queue",
        "institution_workflow_projection"
      ]
    },
    "boardModuleView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "required", "capabilityKey", "capabilityVersion"],
      "properties": {
        "kind": { "$ref": "#/$defs/boardModuleKind" },
        "required": { "type": "boolean" },
        "capabilityKey": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/stableKey"
        },
        "capabilityVersion": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/semver"
        },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "dependencyNoGoView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyKey", "requiredVersion", "reason", "retryHint"],
      "properties": {
        "dependencyKey": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/stableKey"
        },
        "requiredVersion": {
          "$ref": "../../interface/contract-primitives.schema.json#/$defs/semver"
        },
        "reason": {
          "enum": ["missing", "unqualified", "unavailable", "contract_mismatch"]
        },
        "retryHint": {
          "enum": ["retry", "setup", "required_upgrade", "contact_admin", "none"]
        }
      }
    },
    "careItemView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemRef", "acknowledgementState", "responseState", "lifecycle"],
      "properties": {
        "itemRef": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "enrollmentRef": {
          "$ref": "../world/synthetic-world.schema.json#/$defs/syntheticId"
        },
        "acknowledgementState": { "enum": ["pending", "acknowledged"] },
        "responseState": { "enum": ["awaiting_reply", "responded"] },
        "lifecycle": { "enum": ["active", "closed", "suppressed"] },
        "attentionState": { "enum": ["active", "resolved", "suppressed"] },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "source_question",
                  "caregiver_reply",
                  "correction_notice",
                  "redaction_tombstone"
                ]
              }
            }
          }
        }
      }
    }
  }
}

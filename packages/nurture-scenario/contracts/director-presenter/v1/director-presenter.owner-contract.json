              "context_changed",
              "ambiguous_institution",
              "purpose_denied",
              "protected_material_denied",
              "refresh_not_retryable"
            ]
          },
          "purge_partition": {
            "const": true
          },
          "content_masked": {
            "const": true
          },
          "material_access_invalidated": {
            "const": true
          }
        }
      },
      "masked_response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "masked_at",
          "mask_signal"
        ],
        "properties": {
          "status": {
            "const": "masked"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "masked_at": {
            "type": "string",
            "format": "date-time"
          },
          "mask_signal": {
            "$ref": "#/$defs/mask_signal"
          }
        }
      },
      "unavailable_response": {
        "type": "object",
        "additionalProperties": false,

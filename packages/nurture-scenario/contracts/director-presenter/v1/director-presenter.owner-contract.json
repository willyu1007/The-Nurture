            "$ref": "#/$defs/opaque_ref"
          },
          "resolution_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "scope_version": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "enum": [
              "overview_query",
              "drilldown_query",
              "material_query"
            ]
          },
          "query_key": {
            "$ref": "#/$defs/non_empty_string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "mask_signal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason_code",
          "purge_partition",
          "content_masked",
          "material_access_invalidated"
        ],
        "properties": {
          "kind": {

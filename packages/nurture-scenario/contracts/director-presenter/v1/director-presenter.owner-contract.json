        "minLength": 1,
        "maxLength": 256
      },
      "opaque_ref": {
        "type": "string",
        "minLength": 8,
        "maxLength": 512
      },
      "interface_contract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version",
          "digest"
        ],
        "properties": {
          "key": {
            "const": "nurture.director-presenter"
          },
          "version": {
            "const": "1.0.0"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "owner_resolution": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolution_ref",
          "presentation_role",
          "scope_kind",
          "scope_ref",
          "context_ref",
          "scope_version",
          "resolved_at"
        ],
        "properties": {
          "resolution_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "presentation_role": {
            "const": "institution_director"
          },
          "scope_kind": {
            "const": "institution"
          },
          "scope_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "scope_version": {
            "type": "integer",
            "minimum": 1
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "cache_partition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partition_key",
          "interface_key",
          "interface_version",
          "contract_digest",
          "workspace_id",
          "my_chat_user_id",
          "presentation_role",
          "context_ref",
          "resolution_ref",
          "scope_version",
          "operation",
          "query_key",
          "expires_at"
        ],
        "properties": {
          "partition_key": {
            "$ref": "#/$defs/opaque_ref"
          },
          "interface_key": {
            "const": "nurture.director-presenter"
          },
          "interface_version": {
            "const": "1.0.0"
          },

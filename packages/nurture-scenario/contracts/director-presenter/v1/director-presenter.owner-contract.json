{
  "schema_version": 1,
  "interface": {
    "key": "nurture.director-presenter",
    "version": "1.0.0",
    "kind": "private_owner_presenter"
  },
  "surface_baseline": {
    "key": "nurture.surface-contract",
    "version": "1.20.0",
    "relationship": "standalone_composition_no_surface_mutation"
  },
  "publication_posture": {
    "default_off": true,
    "route_registration": "scenario_service_mounted_default_off",
    "runtime_adapter": "owner_ports_required_default_off",
    "activation_authority": "none",
    "consumer_adoption": "exact_key_version_digest_only"
  },
  "transport": {
    "method": "POST",
    "content_type": "application/json",
    "authentication": "service_bearer",
    "cache_control": "private, no-store",
    "paths": {
      "overview_query": "/internal/nurture/director-presenter/v1/overview",
      "drilldown_query": "/internal/nurture/director-presenter/v1/drilldown",
      "material_query": "/internal/nurture/director-presenter/v1/materials"
    }
  },
  "owner_resolution": {
    "frequency": "every_call_and_every_drilldown_or_material_open",
    "accepted_caller_context": [
      "interface_contract",
      "workspace_id",
      "my_chat_user_id",
      "host_request_id",
      "context_ref"
    ],
    "forbidden_caller_authority_fields": [
      "participant_id",
      "role",
      "role_assignment_id",
      "scope_id",
      "institution_id",
      "care_group_id",
      "family_id",
      "child_id",
      "enrollment_id",
      "grant_id",
      "purpose"
    ],
    "current_owner_facts": [
      "active Participant bound from the authenticated My-Chat user",
      "current institution director or administrator RoleAssignment",
      "exact current workspace association and Institution selected by context_ref",
      "current purpose and protected-display policy for each overview, drilldown and material read"
    ],
    "context_ref_rule": "context_ref is routing input and a cache dimension, never authorization",
    "safe_projection": "Responses contain owner-approved display values and opaque refs only"
  },
  "mobile_posture": {
    "mode": "read_only",
    "operation_entry": "web_workbench_required",
    "forbidden_response_fields": [
      "action_ref",
      "confirmation_ref",
      "command_request_id",
      "participant_id",
      "role_assignment_id",
      "institution_id",
      "family_id",
      "child_id",
      "grant_id",
      "storage_ref",
      "signed_url",
      "url"
    ],
    "rules": [
      "Institution Mobile remains a read-only board; commands stay in InstitutionAdminWorkbench.",
      "Attention signals describe support context and never rank or judge staff.",
      "Family-private content is absent by default and cannot be inferred from empty aggregates.",
      "Protected material access is reread on every open and never implies download or share authority."
    ]
  },
  "safe_reason_codes": [
    "access_changed",
    "context_changed",
    "ambiguous_institution",
    "purpose_denied",
    "protected_material_denied",
    "refresh_not_retryable",
    "content_unavailable",
    "temporarily_unavailable",
    "request_invalid",
    "mobile_action_forbidden"
  ],
  "operation_order": [
    "overview_query",
    "drilldown_query",
    "material_query"
  ],
  "operations": {
    "overview_query": {
      "t039_rows": [
        "D-O01",
        "D-O02",
        "D-O03",
        "D-O04",
        "D-O05",
        "D-O06",
        "D-O07",
        "D-O08",
        "D-O09",
        "D-O10",
        "D-O13",
        "D-O14"
      ],
      "request_schema_ref": "urn:nurture:director-presenter:1#/$defs/overview_query_request",
      "response_schema_ref": "urn:nurture:director-presenter:1#/$defs/overview_query_response",
      "rules": [
        "All eleven sections are returned independently so one missing source does not blank the page.",
        "Missing is never interpreted as zero, absence, normality or successful delivery.",
        "The operation_entry section is always unavailable with web_workbench_required and carries no action fields."
      ]
    },
    "drilldown_query": {
      "t039_rows": [
        "D-O02",
        "D-O03",
        "D-O05",
        "D-O06",
        "D-O07",
        "D-O09",
        "D-O10",
        "D-O11"
      ],
      "request_schema_ref": "urn:nurture:director-presenter:1#/$defs/drilldown_query_request",
      "response_schema_ref": "urn:nurture:director-presenter:1#/$defs/drilldown_query_response",
      "rules": [
        "The opaque drilldown_ref fixes the owner-approved next level and purpose.",
        "Every open rereads current authority; no overview snapshot grants deeper access.",
        "Results are capped at 50 and contain no family-private body or staff ranking."
      ]
    },
    "material_query": {
      "t039_rows": [
        "D-O12"
      ],
      "request_schema_ref": "urn:nurture:director-presenter:1#/$defs/material_query_request",
      "response_schema_ref": "urn:nurture:director-presenter:1#/$defs/material_query_response",
      "rules": [
        "The owner-issued collection_ref is presentation routing only and each open rereads purpose.",
        "At most 20 entries are returned; protected media uses expiring owner-stream access refs only.",
        "No storage ref, signed URL, download or share capability crosses the contract."
      ]
    }
  },
  "schemas": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:nurture:director-presenter:1",
    "$defs": {
      "non_empty_string": {

            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "workspace_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "my_chat_user_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "presentation_role": {
            "const": "institution_director"
          },

{
  "schema_version": 1,
  "interface": {
    "key": "nurture.teacher-assistant-query-owner",
    "version": "1.0.0",
    "kind": "private_owner_exchange"
  },
  "surface_baseline": {
    "key": "nurture.surface-contract",
    "version": "1.20.0",
    "digest": "sha256:35d6340f60aa2d81523b0c8af977c8c5bb8f01a05a84d1a73b5baffbe8654273",
    "relationship": "standalone_composition_no_surface_mutation"
  },
  "capability_dependencies": [
    {
      "key": "record_caregiver_daily_care",
      "version": "1.0.0",
      "use": "handoff vocabulary only"
    },
    {
      "key": "organize_care_capture_batch",
      "version": "1.0.0",
      "use": "lane vocabulary only"
    }
  ],
  "publication_posture": {
    "default_off": true,
    "route_registration": "scenario_service_mounted_default_off",
    "runtime_adapter": "owner_ports_required_default_off",
    "activation_authority": "none",
    "consumer_adoption": "exact_key_version_digest_only"
  },
  "mobile_posture": {
    "mode": "read_and_command",
    "forbidden_response_fields": [
      "action_ref",
      "participant_id",
      "role_assignment_id",
      "institution_id",
      "family_id",
      "child_id",
      "care_group_id",
      "enrollment_id",
      "grant_id",
      "storage_ref",
      "signed_url",
      "url"
    ],
    "rules": [
      "The supplement handoff is a typed descriptor, never an executable reference; the handoff target rereads current authority and this owner writes nothing on reads.",
      "The weekly draft is agent-labelled owner content and requires review before any sharing; it enters the existing organization lane and never sends.",
      "The generation boundary is engine-ready: the owner assembles deterministic facts only and never calls a model provider; no generated prose exists in this contract.",
      "Week identity is owner-computed under the publication-policy timezone; requests never carry week boundaries."
    ]
  },
  "command_model": {
    "idempotency": "The exchange binds an actor-scoped identity (workspace + current participant + command_request_id); another authorized actor replaying the same command_request_id is denied, never served the first actor's result.",
    "replay": "An exact same-command replay returns the recorded result with executed: replayed and mutates nothing.",
    "outcome_unknown": "Recovery is exact same-command replay; a new command is never the recovery path.",
    "confirmation": "No two-step confirm exists: the weekly draft is a class-internal single-step command (family visibility starts only at the separate release confirm). The draft is additionally domain-idempotent per (class, week) — an existing draft answers already_satisfied with the same process_ref.",
    "no_auto_send": "Nothing here releases, schedules or auto-sends."
  },
  "safe_reason_codes": [
    "teacher_assistant_query_owner_disabled",
    "invalid_teacher_assistant_query_request",
    "teacher_assistant_query_contract_mismatch"
  ],
  "transport": {
    "method": "POST",
    "content_type": "application/json",
    "authentication": "service_bearer",
    "cache_control": "private, no-store",
    "paths": {
      "missing_records_query": "/internal/nurture/teacher-assistant-query-owner/v1/missing-records",
      "weekly_source_query": "/internal/nurture/teacher-assistant-query-owner/v1/weekly-source",
      "weekly_draft_exchange": "/internal/nurture/teacher-assistant-query-owner/v1/weekly-draft"
    }
  },
  "operation_order": [
    "missing_records_query",
    "weekly_source_query",
    "weekly_draft_exchange"
  ],
  "operations": {
    "missing_records_query": {
      "path": "/internal/nurture/teacher-assistant-query-owner/v1/missing-records",
      "t039_rows": [
        "T-H02"
      ],
      "request_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/missing_records_query_request",
      "response_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/missing_records_query_response"
    },
    "weekly_source_query": {
      "path": "/internal/nurture/teacher-assistant-query-owner/v1/weekly-source",
      "t039_rows": [
        "T-H04"
      ],
      "request_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/weekly_source_query_request",
      "response_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/weekly_source_query_response"
    },
    "weekly_draft_exchange": {
      "path": "/internal/nurture/teacher-assistant-query-owner/v1/weekly-draft",
      "t039_rows": [
        "T-H04"
      ],
      "request_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/weekly_draft_exchange_request",
      "response_schema_ref": "urn:nurture:teacher-assistant-query-owner:1#/$defs/weekly_draft_exchange_response"
    }
  },

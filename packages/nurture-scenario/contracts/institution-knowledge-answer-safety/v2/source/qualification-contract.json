    "conflictClasses": [
      "contradictory_action",
      "contradictory_sequence",
      "contradictory_escalation",
      "contraindication_conflict"
    ]
  },
  "regression": {
    "canonicalInputEncoding": "utf8_sorted_object_keys_semantic_array_order_v1",

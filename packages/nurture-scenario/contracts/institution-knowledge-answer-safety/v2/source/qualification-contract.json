      "requested_model_id",
      "resolved_model_id",
      "requested_deployment_id",
      "resolved_deployment_id",
      "request_digest",
      "response_digest"
    ],
    "capabilityPosture": "default_off"
  },
  "forbiddenSubstitutes": [
    "moving_latest_alias",
    "incomplete_fixture_regression",
    "malformed_structured_decision",
    "success_on_service_unavailable"
  ],
  "admission": {
    "mode": "exact_service_prompt_fixture_regression",
    "partialFixturePass": "forbidden",
    "fallbackProvider": "forbidden",
    "defaultOn": "forbidden"
  }

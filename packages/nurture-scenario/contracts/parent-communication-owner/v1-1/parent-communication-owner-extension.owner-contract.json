  "privacy_and_minimization": {
    "rules": [
      "The redaction preview is a typed impact summary only: bounded counts and a boolean, never message bodies, reply bodies or derived-record content.",
      "Redaction is irreversible, author-actor only, and always audited through the frozen G4-C cascade; nothing here deletes rows.",
      "The delivery answer is one aggregate state per message under the frozen v1 mapping; recipient identities, receipt ids and per-recipient counts never leave the owner.",
      "Requests never carry participant, family, enrollment or receipt identifiers; the guardian is resolved from current authority on every operation."
    ]
  },
  "command_semantics": {
    "idempotency": "The exchange binds an actor-scoped identity (workspace + current participant + command_request_id); another authorized actor replaying the same command_request_id is denied, never served the first actor's result.",
    "confirmation": "Two-step: redaction_preview_query issues the confirmation for the exact message head; redact_exchange consumes it once, compares the prepared preview digest, and refuses drift as stale_confirmation (re-prepare).",
    "replay": "An exact same-command replay returns the recorded result with execution_disposition: replayed and mutates nothing.",
    "already_satisfied": "A new command against an already-redacted message answers committed with disposition already_satisfied per the frozen G4-C spec — never a refusal.",
    "outcome_unknown": "Recovery is exact same-command replay; a new command is never the recovery path."
  },
  "safe_reason_codes": [
    "parent_communication_extension_disabled",
    "invalid_parent_communication_extension_request",
    "parent_communication_extension_contract_mismatch"
  ],

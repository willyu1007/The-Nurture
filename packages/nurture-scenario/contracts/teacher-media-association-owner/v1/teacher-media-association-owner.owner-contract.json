{
  "schema_version": 1,
  "interface": {
    "key": "nurture.teacher-media-association-owner",
    "version": "1.0.0",
    "kind": "private_owner_exchange"
  },
  "surface_baseline": {
    "key": "nurture.surface-contract",
    "version": "1.20.0",
    "digest": "sha256:35d6340f60aa2d81523b0c8af977c8c5bb8f01a05a84d1a73b5baffbe8654273",
    "relationship": "standalone_composition_no_surface_mutation"
  },
  "capability_dependencies": [
    {
      "key": "confirm_child_media_attribution",
      "version": "1.0.0",
      "use": "associate confirm decisions"
    },
    {
      "key": "reject_child_media_attribution",
      "version": "1.0.0",
      "use": "associate reject decisions"
    },
    {
      "key": "discard_media_asset",
      "version": "1.0.0",
      "use": "discard exchange"
    }
  ],
  "publication_posture": {
    "default_off": true,
    "route_registration": "scenario_service_mounted_default_off",
    "runtime_adapter": "owner_ports_required_default_off",
    "activation_authority": "none",
    "consumer_adoption": "exact_key_version_digest_only"
  },
  "mobile_posture": {
    "mode": "read_and_command",
    "forbidden_response_fields": [
      "action_ref",
      "participant_id",
      "role_assignment_id",
      "institution_id",
      "family_id",
      "child_id",
      "care_group_id",
      "enrollment_id",
      "grant_id",
      "media_asset_id",
      "attribution_id",
      "storage_ref",
      "signed_url",
      "url",
      "thumbnail_url",
      "preview_ref"
    ],
    "rules": [
      "No bytes, thumbnails or previews exist in this version; the private media stream ingress and My-Chat proxy stay reserved.",
      "Decisions are always explicit child refs; no face or name inference input exists anywhere in this contract.",
      "Multi-selection is a client batch of single-decision idempotent commands, so per-child partial failure stays explicit.",
      "Attribution decisions bind the exact immutable media_revision; a moved revision refuses instead of guessing.",
      "Supersede/correction stays with the G4-C correction-candidate lane; automatic face matching stays default-off G3-C2."
    ]
  },
  "command_model": {
    "idempotency": "Every exchange binds an actor-scoped identity (workspace + current participant + command_request_id); another authorized actor replaying the same command_request_id is denied, never served the first actor's result.",
    "replay": "An exact same-command replay returns the recorded result with executed: replayed and mutates nothing.",
    "outcome_unknown": "Recovery is exact same-command replay; a new command is never the recovery path.",
    "confirmation": "No two-step confirm exists in this contract: association and discard are class-internal single-step commands (nothing here is family-visible until the separate release confirm).",
    "no_auto_send": "Nothing here releases, schedules or auto-sends; association only prepares owner facts for the separate release lifecycle."
  },
  "safe_reason_codes": [
    "teacher_media_association_owner_disabled",
    "invalid_teacher_media_association_request",
    "teacher_media_association_contract_mismatch"
  ],
  "transport": {
    "method": "POST",
    "content_type": "application/json",
    "authentication": "service_bearer",
    "cache_control": "private, no-store",
    "paths": {

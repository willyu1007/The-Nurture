            "$ref": "#/$defs/command_request_id"
          },
          "trigger": {
            "const": "manual"
          }
        }
      },
      "organize_committed": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "outcome": {
                  "const": "organized"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "outcome",
                "process_ref"
              ],
              "properties": {
                "outcome": true,
                "process_ref": true
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "outcome": {
                  "enum": [
                    "nothing_to_organize",
                    "needs_review",
                    "direct_interaction_required"
                  ]
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "process_ref": false
              }
            }
          }
        ],
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "executed",
          "outcome",
          "batch_ref",
          "watermark_sequence",
          "included_capture_count",
          "deferred_capture_count"
        ],
        "properties": {
          "status": {
            "const": "committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "executed": {
            "$ref": "#/$defs/executed_kind"
          },
          "outcome": {
            "enum": [
              "organized",
              "nothing_to_organize",
              "needs_review",
              "direct_interaction_required"
            ]
          },
          "batch_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "watermark_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "included_capture_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "deferred_capture_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "process_ref": {
            "$ref": "#/$defs/opaque_ref"
          }
        }
      },
      "organize_not_committed": {
        "type": "object",
        "additionalProperties": false,

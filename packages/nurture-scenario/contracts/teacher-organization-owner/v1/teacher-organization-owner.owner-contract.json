      "organize_exchange_request": {
        "type": "object",
        "$ref": "#/$defs/identity_request",
        "unevaluatedProperties": false,
        "required": [
          "class_ref",
          "command_request_id",
          "trigger"
        ],
        "properties": {
          "class_ref": {
            "$ref": "#/$defs/opaque_ref"
          },

      "organization_query_request": {
        "type": "object",
        "$ref": "#/$defs/identity_request",
        "unevaluatedProperties": false,
        "required": [
          "class_ref"
        ],
        "properties": {
          "class_ref": {
            "$ref": "#/$defs/opaque_ref"
          }
        }
      },
      "trigger_preview": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "availability": {
                  "const": "available"
                }
              },
              "required": [
                "availability"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "reason_code": false
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "availability": {
                  "enum": [
                    "waiting",
                    "unavailable"
                  ]
                }
              },
              "required": [
                "availability"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "availability",
                "reason_code"
              ],
              "properties": {
                "availability": true,
                "reason_code": true
              }
            }
          }
        ],
        "required": [
          "availability"
        ],
        "properties": {
          "availability": {
            "enum": [
              "available",
              "waiting",
              "unavailable"
            ]
          },
          "reason_code": {
            "enum": [
              "automatic_disabled",
              "batch_not_collecting",
              "empty_stable_batch",
              "idle_not_reached",
              "fallback_not_due",
              "quiescence_gate",
              "policy_unavailable"
            ]
          }
        }
      },
      "admission_preview": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "ready",
                    "already_satisfied"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "reason_code": false
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "waiting",
                    "blocked"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "status",
                "reason_code"
              ],
              "properties": {
                "status": true,
                "reason_code": true
              }
            }
          }
        ],
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "already_satisfied",
              "waiting",
              "blocked"
            ]
          },
          "reason_code": {
            "$ref": "#/$defs/admission_reason"
          }
        }
      },
      "admission_reason": {
        "enum": [
          "quick_adjust_active",
          "edit_hold_active",
          "target_unavailable",
          "needs_review",
          "process_not_draft",
          "unsaved_revision",
          "authorizing_role_lapsed",
          "publication_policy_unavailable"
        ]
      },
      "lane_card": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "process_ref",
          "origin",
          "data_class",
          "purpose_key",
          "state",
          "recipients",
          "admission_preview"
        ],
        "properties": {
          "process_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "origin": {
            "enum": [
              "agent_organized",
              "manual"
            ]
          },
          "data_class": {
            "enum": [
              "daily_care_log",
              "care_day_note",
              "care_constraint_update",
              "family_care_question",
              "family_follow_up_request",
              "direct_care_communication",
              "child_growth_record"
            ]
          },
          "purpose_key": {
            "$ref": "#/$defs/non_empty_string"
          },
          "state": {
            "enum": [
              "draft",
              "needs_review",
              "pending_release"
            ]
          },
          "recipients": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "safe_labels"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "safe_labels": {
                "type": "array",
                "minItems": 0,
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/non_empty_string"

              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "kind",
                "body"
              ],
              "properties": {
                "kind": true,
                "body": true
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "media",
                    "system"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "body": false
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "media"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "kind",
                "has_media"
              ],
              "properties": {
                "kind": true,
                "has_media": {
                  "const": true
                }
              }
            }
          }
        ],
        "required": [
          "message_ref",
          "kind",
          "sender_kind",
          "agent_authored",
          "sender_display",
          "sent_at",
          "delivery_state",
          "has_media"
        ],
        "properties": {
          "message_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "kind": {
            "enum": [
              "text",
              "media",
              "system"
            ]
          },
          "sender_kind": {
            "enum": [
              "parent",
              "teacher",
              "system",
              "agent"
            ]
          },
          "agent_authored": {
            "type": "boolean"
          },
          "sender_display": {
            "$ref": "#/$defs/safe_label"
          },
          "sent_at": {
            "$ref": "#/$defs/instant"
          },
          "delivery_state": {
            "enum": [
              "sent",
              "delivered",
              "read",
              "not_applicable"
            ]
          },
          "has_media": {
            "type": "boolean"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "timeline_page": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "has_more": {
                  "const": true
                }
              },
              "required": [
                "has_more"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "has_more",
                "next_cursor"
              ],
              "properties": {
                "has_more": true,
                "next_cursor": true
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "has_more": {
                  "const": false
                }
              },
              "required": [
                "has_more"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "next_cursor": false
              }
            }
          }
        ],
        "required": [
          "has_more"
        ],
        "properties": {
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "$ref": "#/$defs/cursor_token"
          }
        }
      },
      "timeline_ready": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "owner_resolution",
          "cache_partition",
          "generated_at",
          "freshness",
          "thread_ref",
          "cursor_echo",
          "messages",
          "page"
        ],
        "properties": {
          "status": {
            "const": "ready"
          },
          "owner_resolution": {
            "$ref": "#/$defs/owner_resolution"
          },
          "cache_partition": {
            "$ref": "#/$defs/cache_partition"
          },
          "generated_at": {
            "$ref": "#/$defs/instant"
          },
          "freshness": {
            "$ref": "#/$defs/freshness"
          },
          "thread_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "cursor_echo": {
            "oneOf": [
              {
                "$ref": "#/$defs/cursor_token"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "type": "array",
            "minItems": 0,
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/timeline_message"
            }
          },
          "page": {
            "$ref": "#/$defs/timeline_page"
          }
        }
      },
      "timeline_query_response": {
        "oneOf": [
          {
            "$ref": "#/$defs/timeline_ready"
          },
          {
            "$ref": "#/$defs/masked_response"
          },
          {
            "$ref": "#/$defs/unavailable_response"
          }
        ]
      },
      "send_ready_to_confirm": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "confirmation_ref",
          "prepared_preview_digest",
          "expires_at"
        ],
        "properties": {
          "status": {
            "const": "ready_to_confirm"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "confirmation_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "prepared_preview_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "expires_at": {
            "$ref": "#/$defs/instant"
          }
        }
      },
      "send_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "executed",
          "message_ref",
          "committed_at"
        ],
        "properties": {
          "status": {
            "const": "committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "executed": {
            "$ref": "#/$defs/executed_kind"
          },
          "message_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "committed_at": {
            "$ref": "#/$defs/instant"
          }
        }
      },
      "send_not_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "reason_code"
        ],
        "properties": {
          "status": {
            "const": "not_committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "reason_code": {
            "enum": [
              "confirmation_expired",
              "confirmation_consumed",
              "confirmation_foreign",
              "preview_digest_mismatch",
              "command_actor_mismatch",
              "command_payload_conflict"
            ]
          }
        }
      },
      "send_text_exchange_response": {
        "oneOf": [
          {
            "$ref": "#/$defs/send_ready_to_confirm"
          },
          {
            "$ref": "#/$defs/send_committed"
          },
          {
            "$ref": "#/$defs/send_not_committed"
          },
          {
            "$ref": "#/$defs/outcome_unknown_response"
          },
          {
            "$ref": "#/$defs/masked_response"
          },
          {
            "$ref": "#/$defs/unavailable_response"
          }
        ]
      },
      "withdraw_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "executed",
          "disposition",
          "process_ref",
          "withdrawn_at"
        ],
        "properties": {
          "status": {
            "const": "committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "executed": {
            "$ref": "#/$defs/executed_kind"
          },
          "disposition": {
            "enum": [
              "withdrawn",
              "already_withdrawn"
            ]
          },
          "process_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "withdrawn_at": {
            "$ref": "#/$defs/instant"
          }
        }
      },
      "withdraw_not_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "reason_code"
        ],
        "properties": {
          "status": {
            "const": "not_committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "reason_code": {
            "enum": [
              "target_unavailable",
              "already_released",
              "illegal_transition",
              "cancel_evidence_unavailable",
              "command_actor_mismatch",
              "command_payload_conflict"
            ]
          }
        }
      },
      "withdraw_staged_exchange_response": {
        "oneOf": [
          {
            "$ref": "#/$defs/withdraw_committed"
          },
          {
            "$ref": "#/$defs/withdraw_not_committed"
          },
          {
            "$ref": "#/$defs/outcome_unknown_response"
          },
          {
            "$ref": "#/$defs/masked_response"
          },
          {
            "$ref": "#/$defs/unavailable_response"
          }
        ]
      },
      "mark_read_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "executed",
          "disposition",
          "thread_ref"
        ],
        "properties": {
          "status": {
            "const": "committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "executed": {
            "$ref": "#/$defs/executed_kind"
          },
          "disposition": {
            "enum": [
              "advanced",
              "already_satisfied"
            ]
          },
          "thread_ref": {
            "$ref": "#/$defs/opaque_ref"
          }
        }
      },
      "mark_read_not_committed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "context_ref",
          "command_request_id",
          "reason_code"
        ],
        "properties": {
          "status": {
            "const": "not_committed"
          },
          "context_ref": {
            "$ref": "#/$defs/opaque_ref"
          },
          "command_request_id": {
            "$ref": "#/$defs/command_request_id"
          },
          "reason_code": {
            "enum": [
              "cursor_regression",
              "command_actor_mismatch",
              "command_payload_conflict"
            ]
          }
        }
      },
      "mark_read_exchange_response": {
        "oneOf": [
          {
            "$ref": "#/$defs/mark_read_committed"
          },
          {
            "$ref": "#/$defs/mark_read_not_committed"
          },
          {
            "$ref": "#/$defs/outcome_unknown_response"
          },
          {
            "$ref": "#/$defs/masked_response"
          },
          {
            "$ref": "#/$defs/unavailable_response"
          }
        ]
      }
    }
  }
}

{
  "schema_version": 1,
  "interface": {
    "key": "nurture.teacher-communication-owner",
    "version": "1.0.0",
    "kind": "private_owner_exchange"
  },
  "surface_baseline": {
    "key": "nurture.surface-contract",
    "version": "1.20.0",
    "digest": "sha256:35d6340f60aa2d81523b0c8af977c8c5bb8f01a05a84d1a73b5baffbe8654273",
    "relationship": "standalone_composition_no_surface_mutation"
  },
  "capability_dependencies": [
    {
      "key": "initiate_caregiver_direct_message",
      "version": "1.0.0",
      "use": "target vocabulary only"
    },
    {
      "key": "organize_care_capture_batch",
      "version": "1.0.0",
      "use": "staged-item provenance only"
    }
  ],
  "publication_posture": {
    "default_off": true,
    "route_registration": "scenario_service_mounted_default_off",
    "runtime_adapter": "owner_ports_required_default_off",
    "activation_authority": "none",
    "consumer_adoption": "exact_key_version_digest_only"
  },
  "mobile_posture": {
    "mode": "read_and_command",
    "forbidden_response_fields": [
      "action_ref",
      "participant_id",
      "role_assignment_id",
      "institution_id",
      "family_id",
      "child_id",
      "care_group_id",
      "enrollment_id",
      "grant_id",
      "thread_id",
      "message_id",
      "storage_ref",
      "signed_url",
      "url"
    ],
    "rules": [
      "The class_group rail entry is frozen unavailable (reason class_group_reserved); no operation accepts it as a send target.",
      "Media messages are presence descriptors only; bytes and access stay reserved for the W9 media supply.",
      "Unread counts derive from the teacher's own thread cursor; reads never advance it — mark_read_exchange is the only clear.",
      "Sent-message withdrawal is a different lifecycle outside this contract; withdraw_staged_exchange touches pre-release items only.",
      "Voice input is excluded from every write in this version."
    ]
  },
  "command_model": {
    "idempotency": "Every exchange binds an actor-scoped identity (workspace + current participant + command_request_id); another authorized actor replaying the same command_request_id is denied, never served the first actor's result.",
    "replay": "An exact same-command replay returns the recorded result with executed: replayed and mutates nothing.",
    "outcome_unknown": "Recovery is exact same-command replay; a new command is never the recovery path.",
    "confirmation": "send_text_exchange is the only two-step confirm (outward family-visible effect); its confirmation_ref is single-use, five-minute, body-free, surface-bound and never extended or revived.",
    "no_auto_send": "Nothing here schedules or auto-sends; scheduled delivery stays gated on product decision I-Q1 outside this contract."
  },
  "safe_reason_codes": [
    "teacher_communication_owner_disabled",
    "invalid_teacher_communication_request",
    "teacher_communication_contract_mismatch"
  ],
  "transport": {
    "method": "POST",
    "content_type": "application/json",
    "authentication": "service_bearer",
    "cache_control": "private, no-store",
    "paths": {
      "targets_query": "/internal/nurture/teacher-communication-owner/v1/targets",
      "membership_query": "/internal/nurture/teacher-communication-owner/v1/membership",
      "timeline_query": "/internal/nurture/teacher-communication-owner/v1/timeline",
      "send_text_exchange": "/internal/nurture/teacher-communication-owner/v1/send-text",
      "withdraw_staged_exchange": "/internal/nurture/teacher-communication-owner/v1/withdraw-staged",
      "mark_read_exchange": "/internal/nurture/teacher-communication-owner/v1/mark-read"
    }
  },
  "operation_order": [
    "targets_query",
    "membership_query",
    "timeline_query",
    "send_text_exchange",
    "withdraw_staged_exchange",
    "mark_read_exchange"
  ],
  "operations": {

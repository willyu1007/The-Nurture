{
  "name": "@the-nurture/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Nurture data layer: Prisma client + repository implementations of the scenario repository ports. The only package allowed to import Prisma (business layer stays Prisma-free).",
  "exports": {
    ".": "./src/index.ts",
    "./binding-owner": {
      "types": "./src/binding-owner.ts",
      "import": "./dist/binding-owner.js",
      "default": "./dist/binding-owner.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@my-chat/workflow-contracts": "0.1.0",
    "@prisma/client": "^5.22.0",
    "@the-nurture/scenario": "workspace:*"
  },
  "devDependencies": {
    "@my-chat/db": "0.1.0",
    "@my-chat/scenario-integrations": "0.1.0",
    "@my-chat/workers": "0.1.0",
    "@my-chat/workflow-runtime": "0.1.0"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.the-nurture.local/release/nurture-service-candidate-freeze-evidence-v1.schema.json",
  "title": "NurtureServiceCandidateFreezeEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "evidence_ref",
    "evidence_digest",
    "candidate_ref",
    "candidate_digest",
    "source_revision",
    "recorded_on",
    "result",
    "checks",
    "final_posture"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_kind": { "const": "nurture_service_candidate_freeze_evidence_v1" },
    "evidence_ref": { "const": "nurture.service-candidate.freeze-evidence@1.0.0" },
    "evidence_digest": { "$ref": "#/$defs/sha256" },
    "candidate_ref": { "const": "nurture.service-candidate@1.0.0" },
    "candidate_digest": { "$ref": "#/$defs/sha256" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recorded_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "result": { "const": "G5_A_CANDIDATE_FROZEN_DEFAULT_OFF" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "const": "pass" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "final_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_frozen",
        "capabilities_default_off",
        "database_apply",
        "deployment",
        "activation",
        "internal_testing",
        "traffic"
      ],
      "properties": {
        "candidate_frozen": { "const": true },
        "capabilities_default_off": { "const": true },
        "database_apply": { "const": false },
        "deployment": { "const": false },
        "activation": { "const": false },
        "internal_testing": { "const": false },
        "traffic": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

  "terms": [
    {
      "term": "Evidence record",
      "definition": "对权威写入或高风险操作的最小解释性记录，用于合规、调试和重放解释。",
      "scope": "workflow",
      "aliases": [
        "evidence log"
      ],
      "see_also": [
        "Artifact"
      ]
    },
    {
      "term": "Mother / expectant mother",
      "definition": "The Nurture 的优先用户和 canonical object 之一，覆盖备孕、孕期、产后恢复、婴幼儿照护和家庭育儿决策中的主要照护者。",
      "scope": "nurture",
      "aliases": [
        "宝妈",
        "准妈妈",
        "孕产妇用户"
      ],
      "see_also": [
        "Pregnancy stage",
        "Health state"
      ]
    },
    {
      "term": "Pregnancy stage",
      "definition": "与孕周、产检节点、身体状态和家庭准备事项相关的阶段上下文。",
      "scope": "nurture",
      "aliases": [
        "孕期阶段",
        "孕周阶段"
      ],
      "see_also": [
        "Mother / expectant mother",
        "Health state"
      ]
    },
    {
      "term": "Health state",
      "definition": "用户记录的孕期、产后、孩子身体状态、症状观察、儿保/产检结论 refs 和相关证据。",
      "scope": "nurture",
      "aliases": [
        "健康状态",
        "身体状态"
      ],
      "see_also": [
        "Basic medical guidance"
      ]
    },
    {
      "term": "Basic medical guidance",
      "definition": "非诊断性的健康信息整理、观察建议、问题清单、就医/复诊提示和急症升级提醒。",
      "scope": "nurture",
      "aliases": [
        "基础医疗建议",
        "健康提醒"
      ],
      "see_also": [
        "Health state"
      ]
    },
    {
      "term": "Scenario profile",
      "definition": "The Nurture 维护的孕育/养育场景画像，必须通过 canonical object ref 贴附到 My-Chat 对象。",
      "scope": "nurture",
      "aliases": [
        "nurture profile",
        "场景画像"
      ],
      "see_also": [
        "Canonical object"
      ]
    },
    {
      "term": "Canonical object",
      "definition": "My-Chat 数据库中的平台对象身份，例如宝妈/准妈妈、孩子、家庭、父母或活动对象。",
      "scope": "global",
      "aliases": [
        "My-Chat object",
        "platform object"
      ],
      "see_also": [
        "Scenario profile",
        "Domain Context Ref"
      ]
    },
    {
      "term": "Development constraint",
      "definition": "与孩子年龄阶段和通用发展规律相关的适配性约束。",
      "scope": "nurture",
      "aliases": [
        "阶段约束",
        "通用发展约束"
      ],
      "see_also": [
        "Activity candidate"
      ]
    },
    {
      "term": "Family constraint",
      "definition": "家庭本地的预算、时间、节律、父母精力、交通和协作边界。",
      "scope": "nurture",
      "aliases": [
        "家庭约束"
      ],
      "see_also": [
        "Long-term goal",
        "Activity candidate"
      ]
    },
    {
      "term": "Activity candidate",
      "definition": "可被评估和安排的活动对象，例如课程、旅行、运动、娱乐、学习任务或家庭活动。",
      "scope": "nurture",
      "aliases": [
        "活动候选",
        "活动对象"
      ],
      "see_also": [
        "Development constraint",
        "Family constraint",
        "Review result"
      ]
    },
    {
      "term": "Review result",
      "definition": "用户执行计划后的结果记录、观察和复盘结论，用于后续证据和 context 更新。",
      "scope": "nurture",
      "aliases": [
        "复盘结果"
      ],
      "see_also": [
        "Evidence record",
        "Long-term goal"
      ]
    },
    {
      "term": "The Nurture",
      "definition": "My-Chat 框架下的儿童照护与园区协同场景模块/服务。Nurture 拥有照护领域事实、业务策略、ActionExecution、CareInteraction、PublishProcess、InstitutionWorkflow 语义和角色安全投影；不拥有平台身份、宿主 shell 或共享运行时。",
      "scope": "global",
      "aliases": [
        "nurture scenario",
        "照护场景"
      ],
      "see_also": [
        "My-Chat",
        "Scenario module",
        "CareInteraction",
        "InstitutionWorkflow"
      ]
    },
    {
      "term": "My-Chat",
      "definition": "The Nurture 的宿主产品，拥有 canonical identity、认证、native/web shell、共享运行时、Handoff、Outbox、notification、deep link 和设备分发，并通过版本化认证接口消费 Nurture。",
      "scope": "global",
      "aliases": [
        "host product",
        "宿主平台"
      ],
      "see_also": [
        "The Nurture",
        "ActionDelivery",
        "InstitutionWorkflowRun"
      ]
    },
    {
      "term": "Scenario module",
      "definition": "接入 My-Chat 的场景契约单元，包含 scenario identity、manifest、capabilities、handlers、actions、presenters、policies 和 adapters。Scenario module 本身不是产品 Workflow。",
      "scope": "global",
      "aliases": [
        "scenario module",
        "Workflow scenario",
        "场景模块"
      ],
      "see_also": [
        "The Nurture",
        "Capability",
        "Entrypoint"
      ]
    },
    {
      "term": "Capability",
      "definition": "Scenario 暴露的版本化查询、ActionExecution 或 InstitutionWorkflow 操作能力。Capability 必须显式声明 operation class；异步或跨 owner 不自动等于 Workflow。",
      "scope": "global",
      "aliases": [
        "场景能力"
      ],
      "see_also": [
        "Entrypoint",
        "ActionExecution",
        "InstitutionWorkflow"
      ]
    },
    {
      "term": "Entrypoint",
      "definition": "某个版本化 capability 的精确启动/调用入口，定义 typed input、允许 surface、confirmation、handler binding 和兼容规则；并非所有 Entrypoint 都启动 Workflow。",
      "scope": "global",
      "aliases": [
        "能力入口"
      ],
      "see_also": [
        "Capability"
      ]
    },
    {
      "term": "ScenarioCapabilityAdapter",
      "definition": "My-Chat chat、board 或 web surface 调用 Nurture query/action/workflow capability 的标准 adapter。它负责接口适配，不拥有 Nurture authority 或业务事实。",
      "scope": "global",
      "aliases": [
        "capability adapter"
      ],
      "see_also": [
        "Capability",
        "ActionExecution",
        "InstitutionWorkflow"
      ]
    },
    {
      "term": "InstitutionWorkflow",
      "definition": "当前阶段仅用于园区管理的持久化业务流程，具有可恢复阶段、里程碑、责任角色、阻塞和下一步。主要操作面是 Institution Web workbench。",
      "scope": "nurture",
      "aliases": [
        "园区管理流程",
        "product Workflow"
      ],
      "see_also": [
        "InstitutionWorkflowRun",
        "InstitutionWorkflowProjection",
        "web_domain_workbench"
      ]
    },
    {
      "term": "InstitutionWorkflowRun",
      "definition": "InstitutionWorkflow 的一次运行实例。通用 Run/Step/worker/ledger 由 My-Chat 或 My-Workflow-Base runtime 拥有；Nurture 拥有业务阶段含义与领域 facts。",
      "scope": "nurture",
      "aliases": [
        "Workflow Run",
        "园区流程实例"
      ],
      "see_also": [
        "InstitutionWorkflow",
        "InstitutionWorkflowProjection"
      ]
    },
    {
      "term": "InstitutionWorkflowProjection",
      "definition": "从当前 InstitutionWorkflow 业务事实和 runtime state 生成的角色安全读模型，可供 mobile board、Web workbench 或其他授权 surface 展示关键内容、阶段、里程碑、阻塞与下一步。",
      "scope": "nurture",
      "aliases": [
        "Workflow projection",
        "园区流程投影"
      ],
      "see_also": [
        "InstitutionWorkflow",
        "Workflow dashboard",
        "web_domain_workbench"
      ]
    },
    {
      "term": "ActionExecution",
      "definition": "经确认后在 Nurture 中原子提交并由 CommandExecution 提供幂等、exact replay 和结果语义的领域动作，例如 submit、acknowledge、reply。",
      "scope": "nurture",
      "aliases": [
        "domain action",
        "原子业务动作"
      ],
      "see_also": [
        "ActionDelivery",
        "CareInteraction",
        "Capability"
      ]
    },
    {
      "term": "ActionDelivery",
      "definition": "My-Chat 将已提交 ActionExecution 的 result/receipt 幂等交给 Handoff、Outbox、notification、deep link 或设备消费面的技术机制。异步投递不是产品 Workflow。",
      "scope": "global",
      "aliases": [
        "delivery dispatch",
        "动作投递"
      ],
      "see_also": [
        "ActionExecution",
        "Handoff",
        "My-Chat"
      ]
    },
    {
      "term": "CareInteraction",
      "definition": "家庭与照护者围绕 Nurture-owned Message、CareItem、Event、Receipt 形成的沟通闭环。Guardian/Caregiver 消费不同角色投影，不建立共享聊天室。",
      "scope": "nurture",
      "aliases": [
        "family-care interaction",
        "家园照护沟通"
      ],
      "see_also": [
        "ActionExecution",
        "CareItemDependency"
      ]
    },
    {
      "term": "PublishProcess",
      "definition": "caregiver 内容的 draft、review、publish、reject、correct 领域状态机。当前它不是 InstitutionWorkflow。",
      "scope": "nurture",
      "aliases": [
        "two-stage publish",
        "发布过程"
      ],
      "see_also": [
        "ActionExecution",
        "InstitutionWorkflow"
      ]
    },
    {
      "term": "CareItemDependency",
      "definition": "未来用于表达 CareItem 前置、触发、状态传播或 SLA 关系的独立模型。它与 contextContinuationOfItemRef 的交流上下文关系不同，当前 Increment 1 不实现。",
      "scope": "nurture",
      "aliases": [
        "事项依赖"
      ],
      "see_also": [
        "CareInteraction"
      ]
    },
    {
      "term": "Handoff",
      "definition": "My-Chat 下游 owner 之间的 refs-only 技术交接契约。Handoff 属于 ActionDelivery/宿主 runtime，不自动创建产品 Workflow 或授予 Nurture 数据权限。",
      "scope": "global",
      "aliases": [
        "handoff request",
        "handoff receipt"
      ],
      "see_also": [
        "ActionDelivery",
        "My-Chat"
      ]
    },
    {
      "term": "Long-term goal",
      "definition": "家庭对孩子成长方向的长期目标或价值导向，是 Nurture 场景事实和决策输入；当前不因持续时间长而自动成为 Workflow。",
      "scope": "nurture",
      "aliases": [
        "长期目标"
      ],
      "see_also": [
        "Family constraint",
        "Review result"
      ]
    },
    {
      "term": "Domain Context Ref",
      "definition": "共享 workflow runtime 面向 canonical domain object 的稳定引用，包含 namespace、object_type、object_id、version 和 owner_scope；使用该引用不把对应业务能力自动分类为产品 Workflow。",
      "scope": "workflow-runtime",
      "aliases": [
        "context ref",
        "canonical ref"
      ],
      "see_also": [
        "Canonical object",
        "Context Snapshot",
        "Context Binding"
      ]
    },
    {
      "term": "Context Snapshot",
      "definition": "共享 workflow runtime 在 run 或 step 中使用的冻结安全视图，用于保证执行时上下文可追踪；它属于 runtime vocabulary，不决定产品层操作分类。",
      "scope": "workflow-runtime",
      "aliases": [
        "snapshot ref"
      ],
      "see_also": [
        "Domain Context Ref"
      ]
    },
    {
      "term": "Context Binding",
      "definition": "共享 workflow runtime 记录某个 run、step 或 artifact 依赖哪些 context refs、snapshots 和 versions 的 ledger 记录；它不是产品 Workflow 的充分条件。",
      "scope": "workflow-runtime",
      "aliases": [
        "binding record"
      ],
      "see_also": [
        "Domain Context Ref",
        "Context Snapshot"
      ]
    },
    {
      "term": "Public-ready draft",
      "definition": "PublishProcess 从私域记录、建议或复盘中生成的可公开草稿，必须经过脱敏、风险标记和用户确认后才可进入论坛或知识链路。",
      "scope": "nurture",
      "aliases": [
        "公开化草稿"
      ],
      "see_also": [
        "PublishProcess",
        "Handoff"
      ]
    },
    {
      "term": "Artifact",
      "definition": "共享 workflow runtime 的 run 可产生的结构化输出或可展示预览，带 exposure level、safe title/summary、source refs 和 storage refs；Artifact 的存在不把普通 ActionExecution 或 PublishProcess 自动分类为产品 Workflow。",
      "scope": "workflow-runtime",
      "aliases": [
        "workflow artifact"
      ],
      "see_also": [
        "Evidence record",
        "ActionExecution",
        "PublishProcess"
      ]
    },
    {
      "term": "Lead designation",
      "definition": "由园区 Admin 指定的日常协调/责任分工标识。它不增加 visibility、capability、Surface 或 Admin/teacher authority；同一用户必须另有当前精确角色并切换 active role 才能执行相应操作。当前持久化可能使用 lead_caregiver 兼容值，但 designation 本身从不授权。",
      "scope": "nurture",
      "aliases": [
        "Lead",
        "负责人标识",
        "日常协调人"
      ],
      "see_also": [
        "lead_caregiver",
        "web_domain_workbench"
      ]
    },
    {
      "term": "lead_caregiver",
      "definition": "现有 Nurture schema/兼容契约中的角色值。只有某个版本化 capability 明确接受该值，且 actor 同时满足当前 exact CareGroup operational-caregiver、Enrollment、Grant、purpose 与 source-lifecycle predicate 时，才可按该 capability 作为 caregiver 操作；该值不授予 T-007 Admin Web、跨班读取或独立 Lead 权限。",
      "scope": "nurture",
      "aliases": [
        "lead caregiver",
        "主班老师兼容角色值"
      ],
      "see_also": [
        "Lead designation",
        "CareInteraction",
        "PublishProcess"
      ]
    },
    {
      "term": "web_run_workbench",
      "definition": "My-Chat 拥有的通用 Workflow Run 操作面（queue、detail、steps、forms、Run 动作），Nurture 通过 nurture.web_run_workbench adapter 提供语义。它不是 Nurture 业务工作台：B3-0 锁定 web_run_workbench MUST NOT 授予 Nurture 业务访问。Nurture 的业务操作面是 web_domain_workbench。",
      "scope": "global",
      "aliases": [
        "Web run workbench",
        "web workflow workbench"
      ],
      "see_also": [
        "web_domain_workbench",
        "InstitutionWorkflow",
        "Workflow dashboard"
      ]
    },
    {
      "term": "web_domain_workbench",
      "definition": "The Nurture 拥有的场景业务工作台，route namespace /nurture，是 InstitutionWorkflow 的主要操作面，承载队列、详情、步骤、表单与授权动作。当前唯一实例是 surface institution_workbench（仅 institution_admin 角色）。它与 My-Chat 的 web_run_workbench 是两个不同表面，不可互为别名。",
      "scope": "nurture",
      "aliases": [
        "Institution workbench",
        "InstitutionAdminWorkbench",
        "机构 Web 操作台",
        "Nurture 业务工作台"
      ],
      "see_also": [
        "web_run_workbench",
        "InstitutionWorkflow",
        "The Nurture web console"
      ]
    },
    {
      "term": "The Nurture web console",
      "definition": "由 My-Chat Web host 承载的 Nurture 场景操作面，用于画像查看、活动建模、复盘、人工确认和场景管理；它不是独立产品 shell。园区管理 InstitutionWorkflow 的主要操作面是 web_domain_workbench（当前实例 institution_workbench），不是 My-Chat 的 web_run_workbench。",
      "scope": "nurture",
      "aliases": [
        "nurture console",
        "场景操作台"
      ],
      "see_also": [
        "web_domain_workbench",
        "InstitutionWorkflow"
      ]
    },
    {
      "term": "Workflow dashboard",
      "definition": "消费 InstitutionWorkflowProjection 的看板型 surface（board）。board 是 Workflow 的 consumer，不拥有也不直接修改 Workflow Run/Step；角色相同本身不授权，每次读取仍须校验 Workspace、Institution、scope、assignment 与 Grant/fact visibility。权威写入只发生在 web_domain_workbench。",
      "scope": "nurture",
      "aliases": [
        "workflow board",
        "流程看板"
      ],
      "see_also": [
        "InstitutionWorkflowProjection",
        "web_domain_workbench"
      ]
    }
  ]
}
